+    @staticmethod
+    def _get_existing_product_path(fs_path: str, fs_dir_path: str) -> Optional[str]:
+        """Look for an already downloaded product, using its expected file or directory path.
+
+        The expected file path is checked first, then the expected directory path, and finally
+        any file or directory located in the same directory and named after the product title
+        (whatever its extension), as the downloaded file may have been renamed after download.
+
+        :param fs_path: expected path to the downloaded product file
+        :param fs_dir_path: expected path to the extracted product directory
+        :returns: the path to the existing product, or None if not found
+        """
+        if os.path.isfile(fs_path):
+            return fs_path
+        if os.path.isdir(fs_dir_path):
+            return fs_dir_path
+
+        parent_dir = os.path.dirname(fs_path)
+        product_name = os.path.basename(fs_dir_path)
+        if not product_name or not os.path.isdir(parent_dir):
+            return None
+
+        try:
+            entries = sorted(os.listdir(parent_dir))
+        except OSError:
+            return None
+
+        for entry in entries:
+            if entry == product_name or not entry.startswith(product_name):
+                continue
+            # only consider files having an extension (e.g. "product.zip"), to avoid
+            # matching another product whose title starts with the same name
+            if not os.path.splitext(entry)[1]:
+                continue
+            entry_path = os.path.join(parent_dir, entry)
+            if os.path.isfile(entry_path) or os.path.isdir(entry_path):
+                return entry_path
+
+        return None
+
