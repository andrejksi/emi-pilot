diff --git a/tests/units/test_download_plugins.py b/tests/units/test_download_plugins.py
index ccdb597..7ecbc93 100644
--- a/tests/units/test_download_plugins.py
+++ b/tests/units/test_download_plugins.py
@@ -361,6 +361,51 @@ class TestDownloadPluginHttp(BaseDownloadPluginTest):
             verify=True,
         )
 
+    @mock.patch("eodag.plugins.download.http.requests.Session.request", autospec=True)
+    def test_plugins_download_http_already_downloaded_zip_file(
+        self, mock_requests_session
+    ):
+        """HTTPDownload.download() must not download an existing zip file again"""
+
+        provider = "geodes"
+        product_type = "S2_MSI_L1C"
+        title = "S2A_MSIL1C_20231006T102911_N0509_R108_T31TFK_20231006T141008"
+        local_product_as_archive_path = os.path.join(
+            TEST_RESOURCES_PATH,
+            "products",
+            "as_archive",
+            "S2A_MSIL1C_20180101T105441_N0206_R051_T31TDH_20180101T124911.zip",
+        )
+        properties = {
+            "id": "dummy",
+            "geometry": "POINT (0 0)",
+            "title": title,
+            "downloadLink": "https://geodes-portal.cnes.fr/api/download/dummy",
+        }
+
+        product = self._dummy_downloadable_product(
+            mock_requests_session,
+            local_product_as_archive_path,
+            provider,
+            properties,
+            product_type,
+        )
+        expected_path = os.path.join(self.output_dir, title + ".zip")
+        self.assertEqual(product.download(), expected_path)
+        mock_requests_session.assert_called_once()
+
+        # A new search creates a new product whose location is remote again.
+        new_product = self._dummy_downloadable_product(
+            mock_requests_session,
+            local_product_as_archive_path,
+            provider,
+            properties,
+            product_type,
+        )
+        self.assertEqual(new_product.download(), expected_path)
+        self.assertEqual(new_product.location, path_to_uri(expected_path))
+        mock_requests_session.assert_called_once()
+
     @mock.patch(
         "eodag.plugins.download.http.HTTPDownload._stream_download", autospec=True
     )
