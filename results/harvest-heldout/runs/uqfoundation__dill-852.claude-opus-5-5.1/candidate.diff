+def test_dump_closes_internal_file_on_failure():
+    import os
+    import tempfile
+    from unittest.mock import patch
+
+    class CannotSerialize:
+        def __reduce__(self):
+            raise RuntimeError('cannot serialize')
+
+    opened = []
+    original = tempfile.NamedTemporaryFile
+    def tracked(*args, **kwds):
+        file = original(*args, **kwds)
+        opened.append(file)
+        return file
+    try:
+        errors = []
+        with patch('tempfile.NamedTemporaryFile', tracked):
+            try:
+                dump(CannotSerialize())
+            except RuntimeError as error:
+                errors.append(error)
+        assert len(errors) == 1
+        assert len(opened) == 1
+        assert opened[-1].closed
+        assert not os.path.exists(opened[-1].name)
+
+        with patch('tempfile.NamedTemporaryFile', tracked):
+            dumpfile = dump(x)
+        assert opened[-1] is dumpfile
+        assert not dumpfile.closed
+        assert load(dumpfile) == x
+    finally:
+        for file in opened:
+            file.close()
+
