+def _get_endpoint_from_url(url: str) -> Optional[str]:
+    """Extract the Hub endpoint (scheme + netloc) from a Hub URL, if any."""
+    parsed = urlparse(url)
+    if not parsed.scheme or not parsed.netloc:
+        return None
+    return f"{parsed.scheme}://{parsed.netloc}"
+
