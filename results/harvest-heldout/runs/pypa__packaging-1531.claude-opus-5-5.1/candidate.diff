--- a/src/packaging/_tokenizer.py
+++ b/src/packaging/_tokenizer.py
@@ -39,6 +39,15 @@ class ParserSyntaxError(Exception):
         return f"{self.message}\n    {self.source}\n    {marker}"
 
 
+def _requirement_specifier_regex_str() -> str:
+    """Return the specifier pattern with ``,`` excluded from ``===`` versions."""
+    arbitrary = r"[^\s;)]+"
+    pattern = Specifier._specifier_regex_str
+    if pattern.count(arbitrary) != 1:  # pragma: no cover
+        raise AssertionError("arbitrary version pattern not found")
+    return pattern.replace(arbitrary, r"[^\s;),]+")
+
+
 DEFAULT_RULES: dict[str, re.Pattern[str]] = {
     "LEFT_PARENTHESIS": re.compile(r"\("),
     "RIGHT_PARENTHESIS": re.compile(r"\)"),
@@ -77,8 +86,10 @@ DEFAULT_RULES: dict[str, re.Pattern[str]] = {
         """,
         re.VERBOSE,
     ),
+    # In a requirement string the comma separates specifiers, so an arbitrary
+    # (``===``) version stops at one here, unlike in ``Specifier("===a,b")``.
     "SPECIFIER": re.compile(
-        Specifier._specifier_regex_str,
+        _requirement_specifier_regex_str(),
         re.VERBOSE | re.IGNORECASE,
     ),
     "AT": re.compile(r"\@"),
