+    def test_plugins_download_base_prepare_download_existing_without_record(self):
+        """Download._prepare_download must detect already downloaded products without record file"""
+
+        self.product.location = self.product.remote_location = "http://foo.bar"
+        self.product.product_type = "foo"
+
+        with TemporaryDirectory() as output_dir:
+            download_kwargs = dict(output_dir=output_dir, extract=False)
+            product_path = Path(output_dir) / self.product.properties["title"]
+            recordfile_path = (
+                Path(output_dir)
+                / ".downloaded"
+                / hashlib.md5("foo-dummy".encode("utf-8")).hexdigest()
+            )
+
+            plugin = self.get_download_plugin(self.product)
+
+            # existing product archive without record file
+            product_path.write_bytes(b"some content")
+            with self.assertLogs(level="INFO") as cm:
+                fs_path, record_filename = plugin._prepare_download(
+                    self.product, **download_kwargs
+                )
+                self.assertEqual(fs_path, str(product_path))
+                self.assertIsNone(record_filename)
+                self.assertIn("Product already downloaded", str(cm.output))
+            # record file has been saved to avoid checking again next time
+            self.assertTrue(recordfile_path.is_file())
+
+            # existing product directory without record file
+            recordfile_path.unlink()
+            product_path.unlink()
+            product_path.mkdir()
+            (product_path / "foo").touch()
+            with self.assertLogs(level="INFO") as cm:
+                fs_path, record_filename = plugin._prepare_download(
+                    self.product, **download_kwargs
+                )
+                self.assertEqual(fs_path, str(product_path))
+                self.assertIsNone(record_filename)
+                self.assertIn("Product already downloaded", str(cm.output))
+            self.assertTrue(recordfile_path.is_file())
+
+            # empty product directory without record file: download must be done
+            recordfile_path.unlink()
+            (product_path / "foo").unlink()
+            fs_path, record_filename = plugin._prepare_download(
+                self.product, **download_kwargs
+            )
+            self.assertEqual(fs_path, str(product_path))
+            self.assertIsNotNone(record_filename)
+            self.assertFalse(recordfile_path.is_file())
+
