+@pytest.mark.parametrize("flatten_messages_as_text", [False, True])
+def test_get_clean_message_list_consecutive_string_messages(flatten_messages_as_text):
+    messages = [
+        {"role": "system", "content": "Start with 'FOO'"},
+        {"role": "system", "content": "End with 'BAR'"},
+        {"role": "user", "content": "Just say '.'"},
+    ]
+    result = get_clean_message_list(messages, flatten_messages_as_text=flatten_messages_as_text)
+    assert len(result) == 2
+    assert result[0]["role"] == "system"
+    assert result[0]["content"] == "Start with 'FOO'\nEnd with 'BAR'"
+    assert result[1] == {"role": "user", "content": "Just say '.'"}
+
+
+def test_get_clean_message_list_consecutive_mixed_content_messages():
+    messages = [
+        {"role": "system", "content": "First"},
+        {"role": "system", "content": [{"type": "text", "text": "Second"}]},
+        {"role": "user", "content": [{"type": "text", "text": "Hi"}]},
+        {"role": "user", "content": "There"},
+    ]
+    result = get_clean_message_list(messages)
+    assert result == [
+        {"role": "system", "content": [{"type": "text", "text": "First\nSecond"}]},
+        {"role": "user", "content": [{"type": "text", "text": "Hi\nThere"}]},
+    ]
+
+
