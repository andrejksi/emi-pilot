diff --git a/tests/units/test_download_plugins.py b/tests/units/test_download_plugins.py
index ccdb597..5d88665 100644
--- a/tests/units/test_download_plugins.py
+++ b/tests/units/test_download_plugins.py
@@ -361,6 +361,83 @@ class TestDownloadPluginHttp(BaseDownloadPluginTest):
             verify=True,
         )
 
+    @mock.patch("eodag.plugins.download.http.requests.Session.request", autospec=True)
+    def test_plugins_download_http_zip_file_already_downloaded(
+        self, mock_requests_session
+    ):
+        """HTTPDownload.download() must not download a product twice in a row
+
+        The downloaded file extension may differ from the configured ``output_extension``
+        (here ``.zip`` is guessed from the downloaded content). A second download of the
+        same product must detect the already downloaded file and skip the request.
+        """
+
+        provider = "geodes"
+        download_url = "https://geodes-portal.cnes.fr/api/download/some-product"
+        local_filename = "S2A_MSIL1C_20180101T105441_N0206_R051_T31TDH_20180101T124911"
+        local_product_as_archive_path = os.path.abspath(
+            os.path.join(
+                TEST_RESOURCES_PATH,
+                "products",
+                "as_archive",
+                "{}.zip".format(local_filename),
+            )
+        )
+        product_type = "S2_MSI_L1C"
+
+        eoproduct_props = {
+            "id": "9deb7e78-9341-5530-8fe8-f81fd99c9f0f",
+            "geometry": {
+                "type": "Polygon",
+                "coordinates": [
+                    [
+                        [0.495928592903789, 44.22596415476343],
+                        [1.870237286761489, 44.24783068396879],
+                        [1.888683014192297, 43.25939191053712],
+                        [0.536772323136669, 43.23826255332707],
+                        [0.495928592903789, 44.22596415476343],
+                    ]
+                ],
+            },
+            "productType": product_type,
+            "title": local_filename,
+            "downloadLink": download_url,
+        }
+        eoproduct_props.update(
+            {key: "" for key in DEFAULT_METADATA_MAPPING if key not in eoproduct_props}
+        )
+
+        # first download
+        product = self._dummy_downloadable_product(
+            mock_requests_session,
+            local_product_as_archive_path,
+            provider,
+            eoproduct_props,
+            product_type,
+        )
+        path = product.download()
+        expected_path = os.path.join(
+            self.output_dir, product.properties["title"] + ".zip"
+        )
+        self.assertEqual(path, expected_path)
+        self.assertTrue(os.path.isfile(path))
+        mock_requests_session.assert_called_once()
+
+        # second download of the same product must not trigger any request
+        mock_requests_session.reset_mock()
+        product2 = self._dummy_downloadable_product(
+            mock_requests_session,
+            local_product_as_archive_path,
+            provider,
+            dict(eoproduct_props),
+            product_type,
+        )
+        with self.assertLogs(level="INFO") as cm:
+            path2 = product2.download()
+        self.assertEqual(path2, expected_path)
+        self.assertIn("Product already downloaded", str(cm.output))
+        mock_requests_session.assert_not_called()
+
     @mock.patch(
         "eodag.plugins.download.http.HTTPDownload._stream_download", autospec=True
     )
