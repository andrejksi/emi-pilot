+    def _get_existing_product_path(
+        self,
+        product: EOProduct,
+        fs_path: str,
+        fs_dir_path: str,
+        **kwargs: Unpack[DownloadConf],
+    ) -> Optional[str]:
+        """Look for an already downloaded product in the output directory.
+
+        The product may have been stored using a name that differs from the one built from its
+        ``title`` (e.g. when the filename returned by the server was used instead). This method
+        checks the expected paths first, then the paths built from the product ``id``.
+
+        :param product: The EO product to look for
+        :param fs_path: The expected path of the product archive
+        :param fs_dir_path: The expected path of the extracted product directory
+        :returns: The path of the existing product, or ``None`` if not found
+        """
+        # expected paths
+        if os.path.isfile(fs_path):
+            return fs_path
+        if os.path.isdir(fs_dir_path):
+            return fs_dir_path
+
+        output_dir = (
+            kwargs.get("output_dir")
+            or getattr(self.config, "output_dir", tempfile.gettempdir())
+            or tempfile.gettempdir()
+        )
+        output_extension = kwargs.get("output_extension") or getattr(
+            self.config, "output_extension", ""
+        )
+        prefix = os.path.abspath(output_dir)
+
+        # paths built from the product id
+        product_id = product.properties.get("id")
+        if not product_id:
+            return None
+        sanitized_id = sanitize(str(product_id))
+        if not sanitized_id:
+            return None
+        id_fs_path = os.path.join(prefix, f"{sanitized_id}{output_extension}")
+        id_fs_dir_path = (
+            id_fs_path.replace(output_extension, "") if output_extension else id_fs_path
+        )
+        if os.path.isfile(id_fs_path):
+            return id_fs_path
+        if os.path.isdir(id_fs_dir_path):
+            return id_fs_dir_path
+
+        # paths built from the product id, with the extension of the expected archive
+        expected_extension = os.path.splitext(fs_path)[1]
+        if expected_extension and expected_extension != output_extension:
+            id_fs_path_with_ext = os.path.join(
+                prefix, f"{sanitized_id}{expected_extension}"
+            )
+            if os.path.isfile(id_fs_path_with_ext):
+                return id_fs_path_with_ext
+
+        return None
+
