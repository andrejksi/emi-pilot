--- a/mpmath/tests/test_functions2.py
+++ b/mpmath/tests/test_functions2.py
@@ -129,6 +129,19 @@ def test_bessel_zeros():
     assert besselyzero(0.5,3).ae(7.8539816339744830962)
     assert besselyzero(2,1,1).ae(5.0025829314460639452)
 
+def test_bessely_fp_integer_order():
+    def ae(x, y, tol=1e-12):
+        return abs(x-y) <= abs(y)*tol
+    # integer and nearly integer orders used to divide by sin(pi*n) == 0
+    # or lose all accuracy to cancellation at fixed precision
+    for n in [0, 1, 2, 3, -2, 2+1e-10]:
+        for z in [1.0, 2.5, 10.0, 2+1j]:
+            assert ae(fp.bessely(n, z), complex(mp.bessely(n, z)))
+    assert ae(fp.bessely(2, 1.5, 1), float(mp.bessely(2, 1.5, 1)))
+    assert ae(fp.besselyzero(2, 1), 3.3842417671495934727)
+    assert ae(fp.besselyzero(0, 1), 0.89357696627916752158)
+    assert ae(fp.besselyzero(2, 1, 1), 5.0025829314460639452)
+
