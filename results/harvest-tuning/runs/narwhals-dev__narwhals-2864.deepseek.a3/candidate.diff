+        order = np.argsort(indices, kind="stable")
+        sorted_indices = [indices[i] for i in order]
+        if isinstance(values_native, (pa.Array, pa.ChunkedArray)):
+            values_native = values_native.take(order)
+        elif isinstance(values_native, (list, tuple)):
+            values_native = [values_native[i] for i in order]
+
+        mask = np.zeros(n, dtype=bool)
+        mask[sorted_indices] = True
         return self._with_native(
