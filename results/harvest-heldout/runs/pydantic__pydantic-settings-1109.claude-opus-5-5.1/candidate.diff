+def test_env_nested_dict_value_type_containing_dict(env):
+    """The value type of a dict field is used even when a dict is nested inside it."""
+
+    class Settings(BaseSettings):
+        a: dict[str, list[str]] = {}
+        b: dict[str, list[dict[str, str]]] = {}
+        c: dict[str, tuple[dict[str, int], str]] = {}
+
+        model_config = SettingsConfigDict(env_prefix='APP_', env_nested_delimiter='__')
+
+    env.set('APP_A__X', '["v"]')
+    env.set('APP_B__X', '[{"k": "v"}]')
+    env.set('APP_C__X', '[{"k": 1}, "s"]')
+    s = Settings()
+    assert s.model_dump() == {
+        'a': {'x': ['v']},
+        'b': {'x': [{'k': 'v'}]},
+        'c': {'x': ({'k': 1}, 's')},
+    }
+
+
 ListOrStr = TypeAliasType('ListOrStr', list[str] | str)
 
 
