+    def test_naive_datetime_defaults_to_utc(self):
+        naive = datetime(2030, 1, 1, 12, 0, 0)
+        aware = naive.replace(tzinfo=timezone.utc)
+        assert to_timestamp(naive, time=lambda: 0.0) == pytest.approx(
+            to_timestamp(aware, time=lambda: 0.0), abs=1.0,
+        )
+
+    def test_import_without_tz_database(self, tmp_path):
+        # Simulate a host with neither system tz data nor ``tzdata``.
+        code = (
+            "import sys; sys.modules['tzdata'] = None; "
+            "import kombu.asynchronous.timer"
+        )
+        env = dict(os.environ, PYTHONTZPATH=str(tmp_path))
+        result = subprocess.run(
+            [sys.executable, '-c', code], env=env,
+            capture_output=True, text=True,
+        )
+        assert result.returncode == 0, result.stderr
