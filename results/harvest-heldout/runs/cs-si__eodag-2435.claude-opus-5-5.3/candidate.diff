+    @staticmethod
+    def _check_dates_validity(start: Any = None, end: Any = None) -> None:
+        """Check that the given start and end dates are valid dates and that start
+        is not after end.
+
+        :param start: start date
+        :param end: end date
+        :raises ValidationError: If a date is invalid or if start is after end
+        """
+        parsed: dict[str, dt.datetime] = {}
+        for name, value in (("start", start), ("end", end)):
+            if value is None or value == "":
+                continue
+            if isinstance(value, dt.datetime):
+                parsed[name] = ensure_utc(value)
+            elif isinstance(value, dt.date):
+                parsed[name] = dt.datetime(
+                    value.year, value.month, value.day, tzinfo=dt.timezone.utc
+                )
+            elif isinstance(value, str):
+                try:
+                    parsed[name] = parse_to_utc(value)
+                except (ValidationError, OverflowError) as e:
+                    raise ValidationError(
+                        f"Invalid {name} date: {value!r}", {name}
+                    ) from e
+            else:
+                raise ValidationError(f"Invalid {name} date: {value!r}", {name})
+        if "start" in parsed and "end" in parsed and parsed["start"] > parsed["end"]:
+            raise ValidationError(
+                f"Start date ({start}) must be before end date ({end})",
+                {"start", "end"},
+            )
+
