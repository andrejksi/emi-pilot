+def test_http_scheme_inference():
+    # Scheme in host takes precedence
+    assert Connection("https://mytrinoserver.domain", port=constants.DEFAULT_PORT).http_scheme == constants.HTTPS
+    assert Connection("http://mytrinoserver.domain", port=constants.DEFAULT_TLS_PORT).http_scheme == constants.HTTP
+
+    # Explicit http_scheme is used when host has no scheme
+    assert Connection("mytrinoserver.domain", http_scheme=constants.HTTPS).http_scheme == constants.HTTPS
+    assert Connection(
+        "mytrinoserver.domain", port=constants.DEFAULT_PORT, http_scheme=constants.HTTPS
+    ).http_scheme == constants.HTTPS
+
+    # Scheme inferred from port
+    assert Connection("mytrinoserver.domain", port=constants.DEFAULT_TLS_PORT).http_scheme == constants.HTTPS
+    assert Connection("mytrinoserver.domain", port=constants.DEFAULT_PORT).http_scheme == constants.HTTP
+
+    # Falls back to http
+    assert Connection("mytrinoserver.domain").http_scheme == constants.HTTP
+    assert Connection("mytrinoserver.domain", port=9999).http_scheme == constants.HTTP
+
+
