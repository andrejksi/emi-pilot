diff --git a/tests/unit/test_regressions.py b/tests/unit/test_regressions.py
index 8df7a2b..d6123f7 100644
--- a/tests/unit/test_regressions.py
+++ b/tests/unit/test_regressions.py
@@ -3228,3 +3228,38 @@ def test_grid_wrap_with_trailing_comma_keeps_a_dotted_from_import_valid(
         )
         == result
     )
+
+
+def test_section_headings_and_footers_respect_comment_prefix():
+    """Section headings and footers should use the configured comment_prefix, so that
+    an empty prefix allows region-folding comments such as ``#region``.
+    """
+    config = {
+        "comment_prefix": "",
+        "import_heading_stdlib": "#region Standard Library",
+        "import_footer_stdlib": "#endregion Standard Library",
+    }
+    expected = """#region Standard Library
+import os
+import sys
+
+#endregion Standard Library
+"""
+    assert isort.code("import sys\nimport os\n", **config) == expected
+    assert isort.code(expected, **config) == expected
+    assert isort.check_code(expected, show_diff=True, **config)
+
+    assert (
+        isort.code(
+            "import sys\nimport os\n",
+            comment_prefix=" #:",
+            import_heading_stdlib="Standard Library",
+            import_footer_stdlib="End Standard Library",
+        )
+        == """#: Standard Library
+import os
+import sys
+
+#: End Standard Library
+"""
+    )
