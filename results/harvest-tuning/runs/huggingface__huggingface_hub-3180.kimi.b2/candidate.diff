diff --git a/tests/test_xet_utils.py b/tests/test_xet_utils.py
index 893ad1e..f271e82 100644
--- a/tests/test_xet_utils.py
+++ b/tests/test_xet_utils.py
@@ -44,6 +44,61 @@ def test_parse_valid_headers_file_info_with_link() -> None:
     assert file_data.file_hash == "sha256:abcdef"
 
 
+@pytest.mark.parametrize("use_link", [False, True])
+def test_parse_file_info_rewrites_default_refresh_route(use_link: bool) -> None:
+    refresh_route = "https://huggingface.co/api/models/username/repo_name/xet-read-token/token"
+    mock_response = MagicMock()
+    mock_response.headers = {"X-Xet-Hash": "sha256:abcdef"}
+    mock_response.links = {}
+    if use_link:
+        mock_response.links = {"xet-auth": {"url": refresh_route}}
+    else:
+        mock_response.headers["X-Xet-Refresh-Route"] = refresh_route
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://hf-mirror.example/")
+
+    assert file_data is not None
+    assert file_data.file_hash == "sha256:abcdef"
+    assert file_data.refresh_route == "https://hf-mirror.example/api/models/username/repo_name/xet-read-token/token"
+
+
+@pytest.mark.parametrize(
+    "refresh_route",
+    [
+        "/api/refresh",
+        "https://custom.example/api/refresh",
+        "https://huggingface.co.evil.example/api/refresh",
+    ],
+)
+def test_parse_file_info_preserves_non_default_refresh_route(refresh_route: str) -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": refresh_route,
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://hf-mirror.example")
+
+    assert file_data is not None
+    assert file_data.refresh_route == refresh_route
+
+
+def test_parse_file_info_uses_configured_endpoint_by_default(mocker) -> None:
+    mocker.patch.object(constants, "ENDPOINT", "https://hf-mirror.example")
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": "https://huggingface.co/api/refresh",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response)
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://hf-mirror.example/api/refresh"
+
+
 def test_parse_invalid_headers_file_info() -> None:
