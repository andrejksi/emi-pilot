+def test_scatter_partial_indices_arrow() -> None:
+    import pyarrow as pa
+
+    tbl = pa.table({"a": [1, 2, 3], "b": [142, 124, 132]})
+    ser = nw.from_native(tbl, eager_only=True)["a"]
+    assert_equal_data({"a": ser.scatter(1, 999)}, {"a": [1, 999, 3]})
+    assert_equal_data({"a": ser.scatter([0, 2], [999, 888])}, {"a": [999, 2, 888]})
+    assert_equal_data({"a": ser.scatter([2, 0], [999, 888])}, {"a": [888, 2, 999]})
+    assert_equal_data({"a": ser}, {"a": [1, 2, 3]})
