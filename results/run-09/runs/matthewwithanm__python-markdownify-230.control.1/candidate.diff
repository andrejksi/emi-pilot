+        if '_noformat' in parent_tags:
+            return text
+        prefix, suffix, text = chomp(text)
+        if not text:
+            return ''
+        # Use a backtick fence longer than any run of backticks in the text,
+        # and pad with spaces if the text starts or ends with a backtick.
+        fence = '`' * (max([len(m) for m in re.findall(r'`+', text)] or [0]) + 1)
+        if text.startswith('`') or text.endswith('`'):
+            text = ' %s ' % text
+        return '%s%s%s%s%s' % (prefix, fence, text, fence, suffix)
 
