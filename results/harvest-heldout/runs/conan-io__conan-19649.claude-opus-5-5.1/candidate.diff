+@pytest.mark.parametrize("bat", [None, False, True])
+def test_powershell_and_bat_launchers(bat):
+    """ tools.env.virtualenv:bat=True generates the .bat launchers too, not only the .ps1 ones,
+    so the environment can be activated both from PowerShell and from CMD
+    """
+    c = TestClient(light=True)
+    c.save({"dep/conanfile.py": GenConanfile("dep", "0.1"),
+            "consumer/conanfile.txt": "[requires]\ndep/0.1"})
+    c.run("create dep")
+    conf = "-c tools.env.virtualenv:powershell=powershell.exe"
+    if bat is not None:
+        conf += f" -c tools.env.virtualenv:bat={bat}"
+    c.run(f"install consumer -g VirtualBuildEnv -g VirtualRunEnv -of=. -s:a os=Windows {conf}")
+
+    for name in ("conanbuild", "conanrun", "conanbuildenv", "conanrunenv"):
+        assert os.path.isfile(os.path.join(c.current_folder, f"{name}.ps1"))
+        assert os.path.isfile(os.path.join(c.current_folder, f"{name}.bat")) == bool(bat)
+        assert not os.path.isfile(os.path.join(c.current_folder, f"{name}.sh"))
+
+    conanbuild_ps1 = c.load("conanbuild.ps1")
+    assert "conanbuildenv.ps1" in conanbuild_ps1
+    assert ".bat" not in conanbuild_ps1
+    if bat:
+        conanbuild_bat = c.load("conanbuild.bat")
+        assert "conanbuildenv.bat" in conanbuild_bat
+        assert ".ps1" not in conanbuild_bat
+        # Both launchers set the same environment, wrapping commands only needs the .bat
+        conanfile = ConanFileMock()
+        conanfile.conf.define("tools.env.virtualenv:powershell", "powershell.exe")
+        conanfile.conf.define("tools.env.virtualenv:bat", True)
+        cmd = environment_wrap_command(conanfile, "conanbuild", c.current_folder, "mycmd")
+        assert cmd == '"{}" && mycmd'.format(os.path.join(c.current_folder, "conanbuild.bat"))
+        # Without the conf, both are used, as before
+        cmd = environment_wrap_command(ConanFileMock(), "conanbuild", c.current_folder, "mycmd")
+        assert "conanbuild.bat" in cmd and "conanbuild.ps1" in cmd
+
+
+def test_powershell_and_bat_launchers_not_windows():
+    """ the .bat launchers are only generated together with the .ps1 ones in Windows
+    """
+    c = TestClient(light=True)
+    c.save({"conanfile.txt": ""})
+    c.run("install . -g VirtualBuildEnv -s:a os=Linux "
+          "-c tools.env.virtualenv:powershell=pwsh -c tools.env.virtualenv:bat=True")
+    assert os.path.isfile(os.path.join(c.current_folder, "conanbuild.ps1"))
+    assert not os.path.isfile(os.path.join(c.current_folder, "conanbuild.bat"))
+    assert not os.path.isfile(os.path.join(c.current_folder, "conanbuild.sh"))
+
+
