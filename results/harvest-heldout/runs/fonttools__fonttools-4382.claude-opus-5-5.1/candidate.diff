+def _round_points(points: Sequence[Tuple[Real, Real]]) -> list:
+    """Round each (x, y) pair to integers, the way the font stores them.
+
+    IUP optimization decides which deltas can be dropped by comparing point
+    coordinates and deltas (e.g. "are these two points at the same x?").
+    At render time, both coordinates and deltas are integers, so those
+    comparisons must be made on rounded values here too; otherwise a delta
+    may be dropped on the strength of a difference that rounding erases.
+    See https://github.com/fonttools/fonttools/issues/3634
+    """
+    return [(otRound(x), otRound(y)) for x, y in points]
+
+
