-        converter = abstract_inline_conversion(lambda self: '`')
-        return converter(self, el, text, parent_tags)
+        if '_noformat' in parent_tags:
+            return text
+        prefix, suffix, text = chomp(text)
+        if not text:
+            return ''
+        # If the code contains backticks, use a longer backtick sequence as the
+        # delimiter (and pad with spaces if the code starts or ends with a
+        # backtick), so that the backticks inside the code are preserved.
+        if '`' in text:
+            num_backticks = max(len(m) for m in re.findall(r'`+', text)) + 1
+            markup = '`' * num_backticks
+            if text.startswith('`') or text.endswith('`'):
+                text = ' %s ' % text
+        else:
+            markup = '`'
+        return '%s%s%s%s%s' % (prefix, markup, text, markup, suffix)
 
