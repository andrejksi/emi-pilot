diff --git a/markdownify/__init__.py b/markdownify/__init__.py
index 72c5214..9112857 100644
--- a/markdownify/__init__.py
+++ b/markdownify/__init__.py
@@ -23,6 +23,9 @@ re_make_convert_fn_name = re.compile(r'[\[\]:-]')
 # (functionally equivalent to r'^(\n*)(.*?)(\n*)$', but greedy is faster than reluctant here)
 re_extract_newlines = re.compile(r'^(\n*)((?:.*[^\n])?)(\n*)$', flags=re.DOTALL)
 
+# Find runs of backticks (used to determine the code span delimiter length)
+re_code_backtick_run = re.compile(r'`+')
+
 # Escape miscellaneous special Markdown characters
 re_escape_misc_chars = re.compile(r'([]\\&<`[>~=+|])')
 
@@ -482,8 +485,23 @@ class MarkdownConverter(object):
     def convert_code(self, el, text, parent_tags):
         if 'pre' in parent_tags:
             return text
-        converter = abstract_inline_conversion(lambda self: '`')
-        return converter(self, el, text, parent_tags)
+        if '_noformat' in parent_tags:
+            return text
+        prefix, suffix, text = chomp(text)
+        if not text:
+            return ''
+        # If the text contains backticks, use a longer delimiter (one more
+        # backtick than the longest run of backticks in the text) so that the
+        # code span is not terminated prematurely.
+        longest_backtick_run = max((len(m) for m in re_code_backtick_run.findall(text)), default=0)
+        if longest_backtick_run:
+            markup = '`' * (longest_backtick_run + 1)
+            # pad with spaces if the text starts or ends with a backtick
+            if text.startswith('`') or text.endswith('`'):
+                text = ' %s ' % text
+        else:
+            markup = '`'
+        return '%s%s%s%s%s' % (prefix, markup, text, markup, suffix)
 
     convert_del = abstract_inline_conversion(lambda self: '~~')
 
