diff --git a/markdownify/__init__.py b/markdownify/__init__.py
index 72c5214..fccd0a6 100644
--- a/markdownify/__init__.py
+++ b/markdownify/__init__.py
@@ -482,8 +482,20 @@ class MarkdownConverter(object):
     def convert_code(self, el, text, parent_tags):
         if 'pre' in parent_tags:
             return text
-        converter = abstract_inline_conversion(lambda self: '`')
-        return converter(self, el, text, parent_tags)
+        if '_noformat' in parent_tags:
+            return text
+        prefix, suffix, text = chomp(text)
+        if not text:
+            return ''
+        # If the code contains backticks, use a longer delimiter (one more
+        # backtick than the longest run of backticks in the text), and pad
+        # with spaces if the text starts or ends with a backtick.
+        longest_backtick_run = max((len(m) for m in re.findall(r'`+', text)), default=0)
+        delimiter = '`' * (longest_backtick_run + 1)
+        if longest_backtick_run and (text.startswith('`') or text.endswith('`')):
+            # Padding is required, so do not chomp the text.
+            return '%s%s %s %s%s' % (prefix, delimiter, text, delimiter, suffix)
+        return '%s%s%s%s%s' % (prefix, delimiter, text, delimiter, suffix)
 
     convert_del = abstract_inline_conversion(lambda self: '~~')
 
