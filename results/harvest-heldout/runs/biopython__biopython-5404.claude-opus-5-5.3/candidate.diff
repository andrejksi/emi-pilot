@@ -516,6 +516,27 @@ class BgzfTests(unittest.TestCase):
         with open(self.temp_file, "wb") as handle:
             bgzf.BgzfWriter(fileobj=handle)
 
+    def test_writer_incompressible_data(self):
+        """A BgzfWriter must cope with data which does not compress."""
+        import random
+
+        rng = random.Random(42)
+        for size in (65490, 65500, 65516, 65520, 65536, 3 * 65536 + 7):
+            data = bytes(rng.getrandbits(8) for _ in range(size))
+            handle = io.BytesIO()
+            writer = bgzf.BgzfWriter(fileobj=handle, mode="wb")
+            writer.write(data)
+            writer.flush()
+            raw = handle.getvalue()
+            writer.close()
+            self.assertEqual(gzip.decompress(raw), data)
+            reader = bgzf.BgzfReader(fileobj=io.BytesIO(raw), mode="rb")
+            self.assertEqual(reader.read(size), data)
+            reader.close()
+            for _, raw_len, _, data_len in bgzf.BgzfBlocks(io.BytesIO(raw)):
+                self.assertLessEqual(raw_len, 65536)
+                self.assertLessEqual(data_len, 65536)
+
 
 if __name__ == "__main__":
     runner = unittest.TextTestRunner(verbosity=2)
