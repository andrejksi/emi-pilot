+    @staticmethod
+    def _get_existing_fs_path(fs_path: str) -> Optional[str]:
+        """Return the path of an already downloaded product file, if any.
+
+        The downloaded file may be stored either without extension (``fs_path``)
+        or with the extension of the remote file (e.g. ``fs_path.zip`` when
+        ``extract`` is disabled). This method returns the matching existing file
+        path, or ``None`` if no such file exists.
+
+        :param fs_path: The extension-less path of the product
+        :returns: The path to the existing product file, or ``None``
+        """
+        if os.path.isfile(fs_path):
+            return fs_path
+        # look for a file named ``fs_path`` with an extension (e.g. ``fs_path.zip``)
+        fs_path_dir = os.path.dirname(fs_path)
+        fs_path_basename = os.path.basename(fs_path)
+        if not os.path.isdir(fs_path_dir):
+            return None
+        for filename in os.listdir(fs_path_dir):
+            if filename.startswith(fs_path_basename + ".") and os.path.isfile(
+                os.path.join(fs_path_dir, filename)
+            ):
+                return os.path.join(fs_path_dir, filename)
+        return None
+
