     return patch.object(fs._api, "bucket_info", _inner)
 
 
+@pytest.mark.parametrize("mode", ["wb", "w", "xb", "x"])
+@pytest.mark.parametrize("instance_block_size", [False, True])
+def test_stream_file_rejects_write_modes(mode, instance_block_size):
+    # Regression test: streaming files (block_size=0) cannot upload, so every write mode,
+    # including exclusive-create ("x"/"xb"), must raise instead of silently dropping writes.
+    fs = HfFileSystem(block_size=0) if instance_block_size else HfFileSystem()
+    open_kwargs = {} if instance_block_size else {"block_size": 0}
+    with patch.object(fs, "resolve_path") as mock_resolve_path:
+        with pytest.raises(ValueError, match="only supports reading"):
+            fs.open("hf://datasets/user/repo/marker.txt", mode, **open_kwargs)
+    mock_resolve_path.assert_not_called()
+
+
