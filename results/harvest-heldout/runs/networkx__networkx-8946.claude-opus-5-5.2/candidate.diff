+
+
+def test_directed_edge_attr_distinguishes_direction():
+    """
+    Edge labels on directed graphs must keep the successor/predecessor
+    distinction, so in- and out-stars with equal edge labels hash differently.
+    """
+    out_star = nx.DiGraph([(0, 1), (0, 2)])
+    in_star = nx.DiGraph([(1, 0), (2, 0)])
+    for G in (out_star, in_star):
+        nx.set_edge_attributes(G, "e", "label")
+
+    assert nx.weisfeiler_lehman_graph_hash(
+        out_star, edge_attr="label"
+    ) != nx.weisfeiler_lehman_graph_hash(in_star, edge_attr="label")
+
+    out_sub = nx.weisfeiler_lehman_subgraph_hashes(out_star, edge_attr="label")
+    in_sub = nx.weisfeiler_lehman_subgraph_hashes(in_star, edge_attr="label")
+    assert out_sub[0] != in_sub[0]
