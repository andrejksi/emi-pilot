@@ -3428,6 +3433,22 @@ class DuckDBGenerator(generator.Generator):
         )
         return self.sql(case)
 
+    def _nul_terminated_length_sql(self, arg: exp.Expr) -> str | None:
+        # SQLite stops counting text at the first NUL, whereas DuckDB counts the whole
+        # string, so only the part before the first NUL is measured. Values known not
+        # to be text (BLOBs count every byte, numbers have no NUL) keep plain LENGTH.
+        if not arg.type:
+            from sqlglot.optimizer.annotate_types import annotate_types
+
+            arg = annotate_types(arg, dialect=self.dialect)
+
+        if arg.type and not arg.is_type(exp.DType.UNKNOWN, *exp.DataType.TEXT_TYPES):
+            return None
+
+        nul = exp.Chr(expressions=[exp.Literal.number(0)])
+        prefix = exp.SplitPart(this=arg, delimiter=nul, part_index=exp.Literal.number(1))
+        return self.func("LENGTH", prefix)
+
     def bitlength_sql(self, expression: exp.BitLength) -> str:
         if not _is_binary(arg := expression.this):
             return self.func("BIT_LENGTH", arg)
