+@pytest.mark.parametrize("predeclare", [False, True])
+def test_scan_preserves_detector_order(RE, hw, predeclare, monkeypatch):
+    """Detector fields in documents follow the order passed to scan."""
+    if predeclare:
+        monkeypatch.setenv("BLUESKY_PREDECLARE", "1")
+
+    detectors = [hw.det3, hw.det1, hw.det2]
+    collector = DocCollector()
+    RE(scan(detectors, hw.motor, -1, 1, 2), collector.insert)
+
+    (descriptor,) = collector.descriptor[next(iter(collector.descriptor))]
+    events = collector.event[descriptor["uid"]]
+    assert len(events) == 2
+
+    detector_keys = [det.name for det in detectors]
+    descriptor_keys = list(descriptor["data_keys"])
+    assert [key for key in descriptor_keys if key in detector_keys] == detector_keys
+    assert [key for key in descriptor["object_keys"] if key in detector_keys] == detector_keys
+    for event in events:
+        assert [key for key in event["data"] if key in detector_keys] == detector_keys
+
+
+def test_declare_stream_preserves_object_order(RE, hw):
+    """Predeclared descriptors retain the order of their objects."""
+    collector = DocCollector()
+
+    def plan():
+        yield from declare_stream(hw.det3, hw.det1, hw.det2, name="primary")
+        yield from trigger_and_read([hw.det3, hw.det1, hw.det2])
+
+    RE(run_wrapper(plan()), collector.insert)
+
+    (descriptor,) = collector.descriptor[next(iter(collector.descriptor))]
+    assert list(descriptor["object_keys"]) == [hw.det3.name, hw.det1.name, hw.det2.name]
+    assert list(descriptor["data_keys"]) == [hw.det3.name, hw.det1.name, hw.det2.name]
+
+
 def test_double_call(RE):
     uid1 = RE(count([]))
     uid2 = RE(count([]))
