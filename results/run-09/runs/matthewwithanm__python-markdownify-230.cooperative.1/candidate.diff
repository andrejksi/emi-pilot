diff --git a/markdownify/__init__.py b/markdownify/__init__.py
index 72c5214..0341127 100644
--- a/markdownify/__init__.py
+++ b/markdownify/__init__.py
@@ -482,6 +482,18 @@ class MarkdownConverter(object):
     def convert_code(self, el, text, parent_tags):
         if 'pre' in parent_tags:
             return text
+
+        # If the text contains backticks, use a longer sequence of backticks
+        # as the delimiter (with space padding, if needed), so that the
+        # backticks in the text are not interpreted as delimiters.
+        # See https://spec.commonmark.org/0.31.2/#code-spans
+        if '`' in text:
+            longest_backtick_run = max(len(run) for run in re.findall(r'`+', text))
+            delimiter = '`' * (longest_backtick_run + 1)
+            if text.startswith('`') or text.endswith('`'):
+                text = ' %s ' % text
+            return delimiter + text + delimiter
+
         converter = abstract_inline_conversion(lambda self: '`')
         return converter(self, el, text, parent_tags)
 
