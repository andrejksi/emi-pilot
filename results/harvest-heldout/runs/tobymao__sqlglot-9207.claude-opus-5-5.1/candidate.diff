+    def test_negative_limit(self):
+        # A negative LIMIT means "no limit" in SQLite
+        for sql in ("SELECT x FROM t LIMIT -1 OFFSET 5", "SELECT x FROM t LIMIT 5, -1"):
+            with self.subTest(sql=sql):
+                self.validate_all(
+                    "SELECT x FROM t LIMIT -1 OFFSET 5",
+                    read={"sqlite": sql},
+                    write={
+                        "sqlite": "SELECT x FROM t LIMIT -1 OFFSET 5",
+                        "duckdb": "SELECT x FROM t LIMIT ALL OFFSET 5",
+                        "postgres": "SELECT x FROM t LIMIT ALL OFFSET 5",
+                        "tsql": "SELECT x FROM t ORDER BY (SELECT NULL) OFFSET 5 ROWS",
+                    },
+                )
+
+        self.validate_all(
+            "SELECT x FROM t LIMIT -1",
+            write={
+                "duckdb": "SELECT x FROM t LIMIT ALL",
+                "postgres": "SELECT x FROM t LIMIT ALL",
+            },
+        )
+        self.validate_identity("SELECT x FROM t LIMIT 0")
+
+        limit = self.parse_one("SELECT x FROM t LIMIT -10 OFFSET 2").args["limit"]
+        self.assertTrue(limit.is_limit_all)
+
