+    def section_comment(self, text: str) -> str:
+        """Returns ``text`` formatted as a section heading/footer comment line.
+
+        Uses the configured ``comment_prefix`` (minus the leading whitespace that
+        separates inline comments from code) so headings stay consistent with
+        inline comments. An empty prefix leaves the text as-is, which allows
+        headings such as ``#region`` that editors use for folding.
+        """
+        return f"{self.comment_prefix.lstrip()} {text}".lstrip()
