+def test_code_with_backticks():
+    assert md('<code>We have to `manage` this.</code>') == '``We have to `manage` this.``'
+    assert md('<code>Use ``two backticks`` here.</code>') == '```Use ``two backticks`` here.```'
+    assert md('<code>`manage`</code>') == '`` `manage` ``'
+    assert md('<code>``manage``</code>') == '``` ``manage`` ```'
+    assert md('<code>foo <b>`bar`</b> baz</code>') == '``foo `bar` baz``'
+    assert md('<kbd>We have to `manage` this.</kbd>') == '``We have to `manage` this.``'
+    assert md('<samp>We have to `manage` this.</samp>') == '``We have to `manage` this.``'
+    assert md('<pre><code>We have to `manage` this.</code></pre>') == '\n\n```\nWe have to `manage` this.\n```\n\n'
+
+
