+    def _copy_bucket_file(
+        self, source: HfFileSystemResolvedBucketPath, destination: HfFileSystemResolvedBucketPath
+    ) -> None:
+        if self._intrans:
+            raise NotImplementedError("Bucket copies inside a transaction are not supported")
+        if not source.path:
+            raise IsADirectoryError(source.unresolve())
+        if not destination.path:
+            raise IsADirectoryError(destination.unresolve())
+        files = self._api.get_bucket_paths_info(source.bucket_id, [source.path])
+        source_file = next(iter(files), None)
+        if source_file is None:
+            raise FileNotFoundError(source.unresolve())
+        xet_hash = source_file.xet_hash
+        if xet_hash is None:
+            raise NotImplementedError("Bucket file copies require a source Xet hash")
+        if source.unresolve() == destination.unresolve():
+            return
+        self._api.batch_bucket_files(
+            destination.bucket_id,
+            copy=[("bucket", source.bucket_id, xet_hash, destination.path)],
+        )
+        self.invalidate_cache(path=destination.unresolve())
