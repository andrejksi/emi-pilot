diff --git a/test/integration/environment/test_env.py b/test/integration/environment/test_env.py
index 0327c2c..9d30cbf 100644
--- a/test/integration/environment/test_env.py
+++ b/test/integration/environment/test_env.py
@@ -1014,3 +1014,55 @@ def test_hardened_sh(path):
         assert f"MYENVVAR1=value1{sep}init1!!" in c.out
         assert f"MYENVVAR2=init2{sep}value2!!" in c.out
         assert f"MYENVVAR3=value3{sep}init3{sep}value4!!" in c.out
+
+
+def test_powershell_and_bat_launchers():
+    """ It is possible to generate both .ps1 and .bat launchers at the same time
+    """
+    c = TestClient(light=True)
+    conanfile = textwrap.dedent("""\
+        from conan import ConanFile
+        class Pkg(ConanFile):
+            settings = "os"
+            def generate(self):
+                self.buildenv.define("MYVAR", "myvalue")
+        """)
+    c.save({"conanfile.py": conanfile})
+    c.run("install . -s os=Windows -s:b os=Windows -c tools.env.virtualenv:powershell=pwsh "
+          "-c tools.env.virtualenv:powershell_and_bat=True")
+    files = os.listdir(c.current_folder)
+    for f in ("conanbuild", "conanbuildenv", "conanrun", "conanrunenv"):
+        assert f"{f}.ps1" in files
+        assert f"{f}.bat" in files
+    for f in ("conanbuild", "conanrun"):
+        assert f"deactivate_{f}.ps1" in files
+        assert f"deactivate_{f}.bat" in files
+    assert "conanbuildenv.bat" in c.load("conanbuild.bat")
+    assert "conanbuildenv.ps1" in c.load("conanbuild.ps1")
+    assert "MYVAR" in c.load("conanbuildenv.bat")
+    assert "MYVAR" in open(os.path.join(c.current_folder, "conanbuildenv.ps1"),
+                           encoding="utf-16").read()
+
+    # Only one of them is used to wrap commands, the PowerShell one
+    conf = ConanFileMock()
+    conf.conf.define("tools.env.virtualenv:powershell", "pwsh")
+    conf.conf.define("tools.env.virtualenv:powershell_and_bat", True)
+    cmd = environment_wrap_command(conf, "conanbuild", c.current_folder, "mycmd")
+    assert "conanbuild.ps1" in cmd
+    assert "conanbuild.bat" not in cmd
+
+    # Without the conf, only the .ps1 are generated
+    c.save({"conanfile.py": conanfile}, clean_first=True)
+    c.run("install . -s os=Windows -s:b os=Windows -c tools.env.virtualenv:powershell=pwsh")
+    files = os.listdir(c.current_folder)
+    assert "conanbuildenv.ps1" in files
+    assert "conanbuildenv.bat" not in files
+    assert "conanbuild.bat" not in files
+
+    # In non-Windows, the .bat are never generated
+    c.save({"conanfile.py": conanfile}, clean_first=True)
+    c.run("install . -s os=Linux -s:b os=Linux -c tools.env.virtualenv:powershell=pwsh "
+          "-c tools.env.virtualenv:powershell_and_bat=True")
+    files = os.listdir(c.current_folder)
+    assert "conanbuildenv.ps1" in files
+    assert "conanbuildenv.bat" not in files
