+def test_scatter_non_zero_and_partial_indices() -> None:
+    import pyarrow as pa
+
+    df = nw.from_native(pa.table({"a": [1, 2, 3]}), eager_only=True)
+    s = df["a"]
+
+    assert_equal_data({"a": s.scatter(1, 999)}, {"a": [1, 999, 3]})
+    assert_equal_data(
