@@ -118,6 +118,44 @@ class IupTest:
         assert chain1 == chain2, f
         assert costs1 == costs2, f
 
+    def test_optimize_compares_rounded_coords(self):
+        # Points 2, 3 and 4 all render at x=10, but differ before rounding.
+        # Point 3's delta can be interpolated from its neighbours' using the
+        # unrounded coordinates, but not with the rounded ones that are used
+        # at render time (equal x with unequal deltas interpolates to zero),
+        # so it must stay explicit.
+        coords = [(10.4, 0), (10.2, 0), (10.4, 0), (10.2, 30), (10.2, 30)]
+        deltas = [(3, 0), (0, 0), (0, 0), (1, 0), (1, 0)]
+
+        optimized = iup.iup_contour_optimize(deltas, coords)
+
+        assert optimized[3] is not None
+        rounded_coords = [(round(x), round(y)) for x, y in coords]
+        assert iup.iup_contour(optimized, rounded_coords) == deltas
+        assert optimized == iup.iup_contour_optimize(deltas, rounded_coords)
+
+    @pytest.mark.parametrize(
+        "deltas, coords",
+        [
+            ([(5.4, 0.6), (5.4, 0.6)], [(0, 0), (1, 1)]),
+            ([(4.6, 1.4), (5.4, 0.6)], [(0, 0), (1, 1)]),
+            ([(1.5, -1.5), (2.5, 3.2), (0.4, 0.4)], [(0.2, 0.6), (5.5, 1), (2, 2)]),
+        ],
+    )
+    def test_optimize_rounds_inputs(self, deltas, coords):
+        def rounded(points):
+            return [(iup.otRound(x), iup.otRound(y)) for x, y in points]
+
+        expected = iup.iup_contour_optimize(rounded(deltas), rounded(coords))
+
+        assert iup.iup_contour_optimize(deltas, coords) == expected
+        assert iup.iup_delta_optimize(
+            deltas + [(0, 0)] * 4, coords + [(0, 0)] * 4, [len(coords) - 1]
+        ) == expected + [None] * 4
+        for d in expected:
+            if d is not None:
+                assert all(isinstance(v, int) for v in d)
+
 
 if __name__ == "__main__":
     sys.exit(pytest.main(sys.argv))
