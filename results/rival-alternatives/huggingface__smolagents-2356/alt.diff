+def _as_content_list(content: str | list[dict[str, Any]] | None) -> list[dict[str, Any]]:
+    """Returns message content as a list of content elements, wrapping plain strings as a text element."""
+    if content is None:
+        return []
+    if isinstance(content, str):
+        return [{"type": "text", "text": content}]
+    return content
+
+
+def _first_text(content: str | list[dict[str, Any]] | None) -> str | None:
+    """Returns the text of a message content when flattening messages as text."""
+    if content is None or isinstance(content, str):
+        return content
+    return content[0]["text"]
+
+
+def _merge_message_content(
+    previous_message: dict[str, Any],
+    content: str | list[dict[str, Any]] | None,
+    flatten_messages_as_text: bool,
+) -> None:
+    """Merges `content` into `previous_message`, which has the same role, in place."""
+    if content is None or content == [] or content == "":
+        return
+    if flatten_messages_as_text:
+        new_text = _first_text(content)
+        if previous_message["content"]:
+            previous_message["content"] += "\n" + new_text
+        else:
+            previous_message["content"] = new_text
+        return
+    previous_content = previous_message["content"]
+    if isinstance(previous_content, str) and isinstance(content, str):
+        # Keep plain string contents as strings
+        previous_message["content"] = previous_content + "\n" + content if previous_content else content
+        return
+    merged_content = list(_as_content_list(previous_content))
+    for el in _as_content_list(content):
+        assert isinstance(el, dict), "Error: this element should be a dict:" + str(el)
+        if el["type"] == "text" and len(merged_content) > 0 and merged_content[-1]["type"] == "text":
+            # Merge consecutive text messages rather than creating new ones
+            merged_content[-1] = {**merged_content[-1], "text": merged_content[-1]["text"] + "\n" + el["text"]}
+        else:
+            merged_content.append(el)
+    previous_message["content"] = merged_content
+
