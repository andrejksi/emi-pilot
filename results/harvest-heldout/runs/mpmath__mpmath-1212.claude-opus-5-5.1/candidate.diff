diff --git a/mpmath/functions/bessel.py b/mpmath/functions/bessel.py
index f6c3da5..63ce5ff 100644
--- a/mpmath/functions/bessel.py
+++ b/mpmath/functions/bessel.py
@@ -153,9 +153,24 @@ def bessely(ctx, n, z, derivative=0, *, eliminate=True, eliminate_all=False,
             return ctx.inf + (n+z)
         else:
             return ctx.ninf + (n+z)
+    m, d = ctx.nint_distance(n)
+    if d < 0 and ctx._fixed_precision:
+        # The formula below cancels catastrophically for (nearly) integer
+        # orders and needs extra working precision to recover; a
+        # fixed-precision context cannot provide it (for an exact integer
+        # order sin(pi*n) is even exactly zero), so evaluate with
+        # arbitrary precision and convert back.
+        mp = ctx._mp
+        with mp.workprec(ctx.prec):
+            v = mp.bessely(n, z, derivative, eliminate=eliminate,
+                           eliminate_all=eliminate_all,
+                           force_series=force_series, asymp_tol=asymp_tol,
+                           maxprec=maxprec, maxterms=maxterms,
+                           zeroprec=zeroprec, infprec=infprec,
+                           verbose=verbose)
+        return ctx.convert(v)
     # XXX: use hypercomb
     ctx.prec += 10
-    m, d = ctx.nint_distance(n)
     if d < -ctx.prec:
         h = +ctx.eps
         ctx.prec *= 2
diff --git a/mpmath/tests/test_functions2.py b/mpmath/tests/test_functions2.py
