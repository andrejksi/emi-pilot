+def test_parse_file_info_rewrites_refresh_route_with_custom_endpoint() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": "https://huggingface.co/api/models/username/repo_name/xet-read-token/token",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://custom.endpoint/")
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://custom.endpoint/api/models/username/repo_name/xet-read-token/token"
+
+
+def test_parse_file_info_rewrites_refresh_route_from_link_with_custom_endpoint() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {"X-Xet-Hash": "sha256:abcdef"}
+    mock_response.links = {
+        "xet-auth": {"url": "https://huggingface.co/api/models/username/repo_name/xet-read-token/token"},
+    }
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://custom.endpoint")
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://custom.endpoint/api/models/username/repo_name/xet-read-token/token"
+
+
+def test_parse_file_info_uses_configured_endpoint_by_default(monkeypatch) -> None:
+    monkeypatch.setattr(constants, "ENDPOINT", "https://custom.endpoint")
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": "https://huggingface.co/api/models/username/repo_name/xet-read-token/token",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response)
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://custom.endpoint/api/models/username/repo_name/xet-read-token/token"
+
+
+def test_parse_file_info_does_not_rewrite_non_hub_refresh_route() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": "https://huggingface.co.example.com/api/refresh",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://custom.endpoint")
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://huggingface.co.example.com/api/refresh"
+
+
