@@ -264,6 +264,23 @@ class test_multi_args:
         with pytest.raises(KeyError):
             list(multi_args(p, cmd='celery multi', suffix='""'))
 
+    def test_parse__uses_custom_node_class(self, tmp_path):
+        class CustomNode(Node):
+            pass
+
+        class CustomMultiParser(MultiParser):
+            Node = CustomNode
+
+        p = NamespacedOptionParser([
+            'foo', 'bar',
+            f'--pidfile={tmp_path}/%n.pid',
+            f'--logfile={tmp_path}/%n.log',
+        ])
+        p.parse()
+        nodes = list(CustomMultiParser(cmd='celery multi', suffix='""').parse(p))
+        assert len(nodes) == 2
+        assert all(type(n) is CustomNode for n in nodes)
+
     def test_optmerge(self):
         p = NamespacedOptionParser(['foo', 'test'])
         p.parse()
