@@ -349,20 +349,53 @@ class TestRequirementParsing:
         req = Requirement(f"foo{specifier}")
         assert req.specifier == specifier
 
+    @pytest.mark.parametrize(
+        ("requirement_string", "expected"),
+        [
+            ("x===0,>= 0", {"===0", ">=0"}),
+            ("x===0, >=0", {"===0", ">=0"}),
+            ("x===0 , >=0", {"===0", ">=0"}),
+            ("x===0,!= 1.0", {"===0", "!=1.0"}),
+            ("x===0,>=0", {"===0", ">=0"}),
+            ("x (===0,>= 0)", {"===0", ">=0"}),
+            ("x (===0, >=0)", {"===0", ">=0"}),
+            ("x>= 1,===abc", {">=1", "===abc"}),
+            ("x===a,===b, ~= 1.0", {"===a", "===b", "~=1.0"}),
+            ('x===0, >=0 ; python_version >= "3"', {"===0", ">=0"}),
+        ],
+    )
+    def test_arbitrary_version_followed_by_spaced_specifier(
+        self, requirement_string: str, expected: set[str]
+    ) -> None:
+        req = Requirement(requirement_string)
+        assert {str(s) for s in req.specifier} == expected
+        assert req.specifier == SpecifierSet(",".join(sorted(expected)))
+
