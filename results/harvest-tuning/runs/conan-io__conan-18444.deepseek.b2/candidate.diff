+    def test_capture_remote_url_treeless_clone(self):
+        """
+        a treeless clone (git >= 2.43) adds extra info to the "git remote -v" output, like
+        "origin\t<url> (fetch) [tree:0]", and the url must be correctly parsed
+        """
+        folder = temp_folder()
+        url, commit = create_local_git_repo(files={"conanfile.py": self.conanfile}, folder=folder)
+
+        c = TestClient()
+        c.run_command('git clone --filter=tree:0 "{}" myclone'.format(folder))
+        with c.chdir("myclone"):
+            c.run("export .")
+            assert "pkg/0.1: URL: {}".format(url) in c.out
+            assert "pkg/0.1: COMMIT: {}".format(commit) in c.out
+
+    def test_capture_remote_url_with_spaces(self):
+        """
+        the url can contain spaces, and it must be correctly parsed from "git remote -v"
+        """
+        c = TestClient()
+        c.save({"conanfile.py": self.conanfile})
+        c.init_git_repo()
+        c.run_command('git remote add origin "https://github.com/conan-io/conan.git"')
+        c.run("export .")
+        assert "pkg/0.1: URL: https://github.com/conan-io/conan.git" in c.out
+
