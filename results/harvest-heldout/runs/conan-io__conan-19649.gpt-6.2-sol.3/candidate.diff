index 282a5f4..a61e3fb 100644
--- a/test/unittests/tools/env/test_env.py
+++ b/test/unittests/tools/env/test_env.py
@@ -531,3 +531,22 @@ class TestProfileSeparators:
         with pytest.raises(ConanException) as e:
             ProfileEnvironment.loads(myprofile)
         assert "Cannot use (sep) and (path) qualifiers simultaneously" in str(e.value)
+
+
+def test_generate_batch_and_powershell_virtualenv(tmp_path, monkeypatch):
+    from conan.tools.env import environment
+
+    monkeypatch.setattr(environment, "deduce_subsystem", lambda *_: WINDOWS)
+    conanfile = ConanFileMock()
+    conanfile.folders.set_base_generators(str(tmp_path))
+    conanfile.conf.define("tools.env.virtualenv:powershell", "pwsh")
+    conanfile.conf.define("tools.env.virtualenv:generate_bat", True)
+    env = Environment()
+    env.define("BUILD_MODE", "debug")
+
+    env.vars(conanfile, scope="build").save_script("build-settings")
+    environment.generate_aggregated_env(conanfile)
+
+    for extension in ["bat", "ps1"]:
+        assert (tmp_path / f"conanbuild.{extension}").is_file()
+        assert (tmp_path / f"build-settings.{extension}").is_file()
