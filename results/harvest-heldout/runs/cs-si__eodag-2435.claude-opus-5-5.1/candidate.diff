@@ -3462,6 +3462,47 @@ class TestCoreSearch(TestCoreBase):
         _, prepared_search = self.dag._prepare_search(**base)
         self.assertListEqual([("start_datetime", "DESC")], prepared_search["sort_by"])
 
+    @mock.patch(
+        "eodag.api.core.EODataAccessGateway.fetch_collections_list", autospec=True
+    )
+    def test__prepare_search_invalid_dates(self, mock_fetch_collections_list):
+        """_prepare_search must reject invalid or inconsistent dates"""
+        # non-existing day
+        with self.assertRaisesRegex(ValidationError, "2023-11-31"):
+            self.dag._prepare_search(start="2020-01-01", end="2023-11-31")
+        with self.assertRaisesRegex(ValidationError, "2023-11-31"):
+            self.dag._prepare_search(start="2023-11-31")
+        # not a date at all
+        with self.assertRaisesRegex(ValidationError, "not-a-date"):
+            self.dag._prepare_search(end="not-a-date")
+        # start after end
+        with self.assertRaisesRegex(ValidationError, "before"):
+            self.dag._prepare_search(start="2021-01-01", end="2020-01-01")
+        with self.assertRaisesRegex(ValidationError, "before"):
+            self.dag._prepare_search(
+                datetime="2021-01-02T00:00:00Z/2021-01-01T00:00:00Z"
+            )
+        # same date for start and end, and offsets, are accepted
+        _, prepared_search = self.dag._prepare_search(
+            start="2020-01-01", end="2020-01-01"
+        )
+        self.assertEqual(prepared_search["start_datetime"], "2020-01-01")
+        self.dag._prepare_search(
+            start="2020-01-01T01:00:00+02:00", end="2020-01-01T00:00:00Z"
+        )
+
+    @mock.patch("eodag.api.core.EODataAccessGateway._do_search", autospec=True)
+    def test_search_invalid_dates_no_request(self, mock_do_search):
+        """search must raise a ValidationError before querying the provider"""
+        with self.assertRaises(ValidationError):
+            self.dag.search(
+                collection="S2_MSI_L1C",
+                provider="peps",
+                start="2020-01-01",
+                end="2023-11-31",
+            )
+        mock_do_search.assert_not_called()
+
     @mock.patch(
         "eodag.api.core.EODataAccessGateway.fetch_collections_list", autospec=True
     )
