+    def _cp_file_with_bucket(
+        self,
+        resolved_path1: HfFileSystemResolvedRepositoryPath | HfFileSystemResolvedBucketPath,
+        resolved_path2: HfFileSystemResolvedRepositoryPath | HfFileSystemResolvedBucketPath,
+        **kwargs,
+    ) -> None:
+        """Copy a single file when the source and/or the destination is a bucket.
+
+        When the destination is a bucket and the source file is stored on Xet, the copy is done server-side by xet
+        hash (no data is downloaded nor re-uploaded). Otherwise, the file content is read and uploaded.
+        """
+        source = resolved_path1.unresolve()
+        # Bucket contents can change at any time: always get fresh info to avoid copying a stale xet hash.
+        is_bucket_source = isinstance(resolved_path1, HfFileSystemResolvedBucketPath)
+        source_info = self.info(source, refresh=is_bucket_source)
+        if source_info["type"] == "directory":
+            # Folders are implicit in buckets and repositories: nothing to copy.
+            return
+
+        if isinstance(resolved_path2, HfFileSystemResolvedBucketPath):
+            if not resolved_path2.path:
+                raise ValueError(f"Cannot copy '{source}' to the root of a bucket without a file name.")
+            xet_hash = source_info.get("xet_hash")
+            if xet_hash is not None:
+                if isinstance(resolved_path1, HfFileSystemResolvedBucketPath):
+                    source_type, source_id = "bucket", resolved_path1.bucket_id
+                else:
+                    source_type, source_id = resolved_path1.repo_type, resolved_path1.repo_id
+                self._api.batch_bucket_files(
+                    resolved_path2.bucket_id, copy=[(source_type, source_id, xet_hash, resolved_path2.path)]
+                )
+            else:
+                with self.open(source, "rb") as f:
+                    content = f.read()
+                self._api.batch_bucket_files(resolved_path2.bucket_id, add=[(content, resolved_path2.path)])
+        else:
+            # Bucket to repository: no server-side copy available => download and upload.
+            with self.open(source, "rb") as f:
+                content = f.read()
+            commit_message = f"Copy {source} to {resolved_path2.unresolve()}"
+            self._api.upload_file(
+                path_or_fileobj=content,
+                path_in_repo=resolved_path2.path_in_repo,
+                repo_id=resolved_path2.repo_id,
+                token=self.token,
+                repo_type=resolved_path2.repo_type,
+                revision=resolved_path2.revision,
+                commit_message=kwargs.get("commit_message", commit_message),
+                commit_description=kwargs.get("commit_description"),
+            )
+
