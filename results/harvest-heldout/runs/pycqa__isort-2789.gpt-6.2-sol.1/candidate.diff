diff --git a/tests/unit/test_isort.py b/tests/unit/test_isort.py
index ae9f056..07682f9 100644
--- a/tests/unit/test_isort.py
+++ b/tests/unit/test_isort.py
@@ -5994,3 +5994,15 @@ def test_builtin_modules() -> None:
         "from python_none_objects import NoneIterable\n"
     )
     assert isort.code(test_input) == test_output
+
+
+def test_section_comments_use_empty_prefix():
+    options = dict(
+        comment_prefix="",
+        import_heading_stdlib="#region Standard Library",
+        import_footer_stdlib="#endregion Standard Library",
+    )
+    result = isort.code("import sys\n", **options)
+    assert result.startswith("#region Standard Library\n")
+    assert result.endswith("#endregion Standard Library\n")
+    assert isort.code(result, **options) == result
