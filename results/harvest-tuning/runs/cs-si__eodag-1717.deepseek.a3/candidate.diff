+    def _get_existing_product_path(
+        self,
+        fs_path: str,
+        fs_dir_path: str,
+        progress_callback: Optional[ProgressCallback] = None,
+        **kwargs: Unpack[DownloadConf],
+    ) -> Optional[str]:
+        """Check if a product is already available locally, even without its record file.
+
+        The product is considered as already downloaded if its destination path
+        (archive file or extracted directory) already exists and is not empty.
+
+        :param fs_path: The expected path of the downloaded archive
+        :param fs_dir_path: The expected path of the extracted product directory
+        :param progress_callback: (optional) A progress callback
+        :returns: The path to the already downloaded product, or ``None``
+        """
+        if os.path.isfile(fs_path) and os.path.getsize(fs_path) > 0:
+            return self._finalize(
+                fs_path, progress_callback=progress_callback, **kwargs
+            )
+        if os.path.isdir(fs_dir_path) and len(os.listdir(fs_dir_path)) > 0:
+            # ignore temporary files left by an interrupted download
+            if not any(not f.endswith("~") for f in os.listdir(fs_dir_path)):
+                return None
+            return self._finalize(
+                fs_dir_path, progress_callback=progress_callback, **kwargs
+            )
+        return None
+
