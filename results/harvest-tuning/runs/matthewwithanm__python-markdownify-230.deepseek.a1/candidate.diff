diff --git a/markdownify/__init__.py b/markdownify/__init__.py
index 72c5214..f68e4f3 100644
--- a/markdownify/__init__.py
+++ b/markdownify/__init__.py
@@ -482,8 +482,19 @@ class MarkdownConverter(object):
     def convert_code(self, el, text, parent_tags):
         if 'pre' in parent_tags:
             return text
-        converter = abstract_inline_conversion(lambda self: '`')
-        return converter(self, el, text, parent_tags)
+        if '_noformat' in parent_tags:
+            # Nested inside another code element; the outer element handles the markup.
+            return text
+        prefix, suffix, text = chomp(text)
+        if not text:
+            return ''
+        # If the code contains backticks, use a longer run of backticks as the
+        # delimiter (and pad with spaces if the code starts or ends with one).
+        longest_run = max((len(m) for m in re.findall(r'`+', text)), default=0)
+        delimiter = '`' * (longest_run + 1)
+        if text.startswith('`') or text.endswith('`'):
+            text = ' ' + text + ' '
+        return '%s%s%s%s%s' % (prefix, delimiter, text, delimiter, suffix)
 
     convert_del = abstract_inline_conversion(lambda self: '~~')
 
