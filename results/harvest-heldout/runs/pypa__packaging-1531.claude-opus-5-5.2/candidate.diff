@@ -39,6 +39,14 @@ class ParserSyntaxError(Exception):
         return f"{self.message}\n    {self.source}\n    {marker}"
 
 
+_ARBITRARY_VERSION = r"[^\s;)]+"
+if Specifier._specifier_regex_str.count(_ARBITRARY_VERSION) != 1:  # pragma: no cover
+    raise RuntimeError("cannot locate the arbitrary version in the specifier regex")
+_REQUIREMENT_SPECIFIER_REGEX_STR = Specifier._specifier_regex_str.replace(
+    _ARBITRARY_VERSION, r"[^\s;),]+"
+)
+
+
 DEFAULT_RULES: dict[str, re.Pattern[str]] = {
     "LEFT_PARENTHESIS": re.compile(r"\("),
     "RIGHT_PARENTHESIS": re.compile(r"\)"),
@@ -77,8 +85,11 @@ DEFAULT_RULES: dict[str, re.Pattern[str]] = {
         """,
         re.VERBOSE,
     ),
+    # In a requirement string the comma always separates specifiers (PEP 508's
+    # version production cannot contain one), so the arbitrary-equality version
+    # must stop at a comma here, even though ``Specifier("===a,b")`` accepts it.
     "SPECIFIER": re.compile(
-        Specifier._specifier_regex_str,
+        _REQUIREMENT_SPECIFIER_REGEX_STR,
         re.VERBOSE | re.IGNORECASE,
     ),
     "AT": re.compile(r"\@"),
diff --git a/tests/test_requirements.py b/tests/test_requirements.py
