+    def test_CFF2_glyphSet_variations_from_ttx(self):
+        """A CFF2 font imported from TTX must apply variations like the binary."""
+        from fontTools.pens.boundsPen import BoundsPen
+
+        ttx_path = self.getpath("TestSparseCFF2VF.ttx")
+        fontFromTTX = TTFont(recalcBBoxes=False, recalcTimestamp=False)
+        fontFromTTX.importXML(ttx_path)
+        top = fontFromTTX["CFF2"].cff.topDictIndex[0]
+        self.assertIs(top.CharStrings.varStore, top.VarStore)
+
+        buf = BytesIO()
+        fontFromTTX.save(buf)
+        buf.seek(0)
+        fontFromOTF = TTFont(buf)
+
+        def bounds(font, location):
+            glyphSet = font.getGlyphSet(location=location)
+            result = {}
+            for name in glyphSet.keys():
+                pen = BoundsPen(glyphSet)
+                glyphSet[name].draw(pen)
+                result[name] = pen.bounds
+            return result
+
+        default = bounds(fontFromOTF, {})
+        varied = bounds(fontFromOTF, {"wght": 900})
+        self.assertNotEqual(default, varied)
+        self.assertEqual(bounds(fontFromTTX, {}), default)
+        self.assertEqual(bounds(fontFromTTX, {"wght": 900}), varied)
+
