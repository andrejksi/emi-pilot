     if low > high:
         raise ValueError("low above high")
     return max(low, min(x, high))
+
+
+def median(values):
+    if not values:
+        raise ValueError("the median of nothing")
+    mid = len(values) // 2
+    if len(values) % 2:
+        return values[mid]
+    return (values[mid - 1] + values[mid]) / 2
