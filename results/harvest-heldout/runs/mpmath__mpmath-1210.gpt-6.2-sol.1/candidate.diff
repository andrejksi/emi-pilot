+
+
+def test_gammainc_zero_origin_with_negative_endpoint():
+    from mpmath import mp
+
+    end = mp.mpf("-0.1")
+    result = mp.gammainc(3, 0, end)
+    expected = mp.quad(lambda x: x**2 * mp.exp(-x), [0, end])
+    assert mp.almosteq(result, expected)
+    assert mp.almosteq(mp.gammainc(3, end, 0), -expected)
