+    def test_non_string_label_values_coerced_to_string(self):
+        families = [
+            UntypedMetricFamily('u', 'help', labels=['a']),
+            CounterMetricFamily('c', 'help', labels=['a']),
+            GaugeMetricFamily('g', 'help', labels=['a']),
+            SummaryMetricFamily('s', 'help', labels=['a']),
+            HistogramMetricFamily('h', 'help', labels=['a']),
+            GaugeHistogramMetricFamily('gh', 'help', labels=['a']),
+            InfoMetricFamily('i', 'help', labels=['a']),
+            StateSetMetricFamily('ss', 'help', labels=['a']),
+        ]
+        families[0].add_metric([1], 2)
+        families[1].add_metric([1], 2, created=3)
+        families[2].add_metric([1], 2)
+        families[3].add_metric([1], count_value=1, sum_value=2)
+        families[4].add_metric([1], buckets=[('0', 1), ('+Inf', 2)], sum_value=3)
+        families[5].add_metric([1], buckets=[('0', 1), ('+Inf', 2)], gsum_value=3)
+        families[6].add_metric([1], {'c': 2})
+        families[7].add_metric([1], {'x': True})
+        for family in families:
+            self.custom_collector(family)
+            for sample in family.samples:
+                for value in sample.labels.values():
+                    self.assertIsInstance(value, str)
+
+        self.assertEqual(2, self.registry.get_sample_value('u', {'a': '1'}))
+        self.assertEqual(2, self.registry.get_sample_value('c_total', {'a': '1'}))
+        self.assertEqual(3, self.registry.get_sample_value('c_created', {'a': '1'}))
+        self.assertEqual(2, self.registry.get_sample_value('g', {'a': '1'}))
+        self.assertEqual(2, self.registry.get_sample_value('h_bucket', {'a': '1', 'le': '+Inf'}))
+        self.assertEqual(1, self.registry.get_sample_value('i_info', {'a': '1', 'c': '2'}))
+        self.assertEqual(1, self.registry.get_sample_value('ss', {'a': '1', 'ss': 'x'}))
+
+        output = generate_latest(self.registry).decode('utf-8')
+        self.assertIn('g{a="1"} 2.0', output)
+        self.assertIn('c_total{a="1"} 2.0', output)
+
     def test_bad_constructors(self):
         self.assertRaises(ValueError, UntypedMetricFamily, 'u', 'help', value=1, labels=[])
         self.assertRaises(ValueError, UntypedMetricFamily, 'u', 'help', value=1, labels=['a'])
