+    def _get_existing_product_path(self, fs_path: str) -> Optional[str]:
+        """Return the path of an already downloaded product file, if any.
+
+        The downloaded file may have an extension that differs from the configured
+        ``output_extension`` (e.g. when the extension is guessed from the downloaded
+        content). This method looks for a file matching ``fs_path`` either as-is or
+        with any extension.
+
+        :param fs_path: The expected path of the downloaded product
+        :returns: The path of the existing product file, or ``None`` if not found
+        """
+        if os.path.isfile(fs_path):
+            return fs_path
+        # look for the product file with any extension (e.g. ``<title>.zip``)
+        parent_dir, basename = os.path.split(fs_path)
+        if not os.path.isdir(parent_dir):
+            return None
+        for filename in os.listdir(parent_dir):
+            if filename.startswith(f"{basename}.") and os.path.isfile(
+                os.path.join(parent_dir, filename)
+            ):
+                return os.path.join(parent_dir, filename)
+        return None
+
