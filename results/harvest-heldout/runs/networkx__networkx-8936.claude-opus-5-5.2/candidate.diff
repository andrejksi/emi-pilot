+    def test_no_flow_residual_network_without_edges(self):
+        # Only a zero-capacity edge: the residual network has no edges, but
+        # the demands cannot be met.
+        G = nx.DiGraph()
+        G.add_node(0, demand=1)
+        G.add_node(1, demand=-1)
+        G.add_edge(1, 0, capacity=0, weight=1)
+        pytest.raises(nx.NetworkXUnfeasible, nx.network_simplex, G)
+        pytest.raises(nx.NetworkXUnfeasible, nx.min_cost_flow, G)
+        pytest.raises(nx.NetworkXUnfeasible, nx.capacity_scaling, G)
+
+        # No edges at all.
+        G = nx.DiGraph()
+        G.add_node(0, demand=1)
+        G.add_node(1, demand=-1)
+        pytest.raises(nx.NetworkXUnfeasible, nx.capacity_scaling, G)
+
+    def test_residual_network_without_edges_zero_demands(self):
+        G = nx.DiGraph()
+        G.add_node(0)
+        G.add_node(1)
+        G.add_edge(1, 0, capacity=0, weight=1)
+        assert nx.capacity_scaling(G) == (0, {0: {}, 1: {0: 0}})
+
