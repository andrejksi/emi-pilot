+def test_temp_load_closes_owned_file_if_deserializer_raises(monkeypatch, tmp_path):
+    import pytest
+
+    path = tmp_path / "data"
+    path.write_bytes(b"")
+    opened = []
+
+    def fail(stream):
+        opened.append(stream)
+        raise ValueError("load failed")
+
+    monkeypatch.setattr(dill, "load", fail)
+    with pytest.raises(ValueError, match="load failed"):
+        load(str(path))
+    assert opened[0].closed
