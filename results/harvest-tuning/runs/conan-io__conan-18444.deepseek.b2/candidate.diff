-                url, _ = url.rsplit(None, 1)
+                # The url can contain spaces, so we cannot just split by spaces
+                # The format is "<name>\t<url> (fetch|push)[ <extra>]", so we take the
+                # content between the first tab and the " (fetch)" or " (push)" marker
+                url = url.split("\t", 1)[-1]
+                for suffix in (" (fetch)", " (push)"):
+                    idx = url.rfind(suffix)
