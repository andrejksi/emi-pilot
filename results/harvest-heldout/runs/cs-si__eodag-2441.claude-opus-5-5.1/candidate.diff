+def get_product_date(product: EOProduct, key: str) -> Optional[dt.datetime]:
+    """Get a product start or end date as an UTC datetime
+
+    Products that only have a single acquisition instant (e.g. STAC items having a
+    ``datetime`` but neither ``start_datetime`` nor ``end_datetime`` properties) use
+    this instant as both their start and end dates. A product having only one of its
+    start or end dates keeps the other one unknown.
+
+    :param product: The product
+    :param key: The date property to get, ``start_datetime`` or ``end_datetime``
+    :returns: The date, or ``None`` if the product has none
+    """
+    props = product.properties
+    if props.get("start_datetime") or props.get("end_datetime"):
+        date_str = props.get(key)
+    else:
+        date_str = props.get("datetime")
+    if not date_str:
+        return None
+    return parse_to_utc(date_str)
+
+
