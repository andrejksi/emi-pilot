diff --git a/tests/test_xet_utils.py b/tests/test_xet_utils.py
index 893ad1e..96cc452 100644
--- a/tests/test_xet_utils.py
+++ b/tests/test_xet_utils.py
@@ -44,6 +44,63 @@ def test_parse_valid_headers_file_info_with_link() -> None:
     assert file_data.file_hash == "sha256:abcdef"
 
 
+def test_parse_valid_headers_file_info_with_default_endpoint_rewritten() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": "https://huggingface.co/api/models/username/repo_name/xet-read-token/token",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response)
+
+    assert file_data is not None
+    assert file_data.refresh_route == f"{constants.ENDPOINT}/api/models/username/repo_name/xet-read-token/token"
+    assert file_data.file_hash == "sha256:abcdef"
+
+
+def test_parse_valid_headers_file_info_with_custom_endpoint() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": "https://huggingface.co/api/models/username/repo_name/xet-read-token/token",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://custom.endpoint.co")
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://custom.endpoint.co/api/models/username/repo_name/xet-read-token/token"
+    assert file_data.file_hash == "sha256:abcdef"
+
+
+def test_parse_valid_headers_file_info_with_custom_endpoint_and_link() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {"X-Xet-Hash": "sha256:abcdef"}
+    mock_response.links = {
+        "xet-auth": {"url": "https://huggingface.co/api/models/username/repo_name/xet-read-token/token"},
+    }
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://custom.endpoint.co")
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://custom.endpoint.co/api/models/username/repo_name/xet-read-token/token"
+
+
+def test_parse_valid_headers_file_info_with_custom_endpoint_not_rewritten() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": "https://other.endpoint.co/api/refresh",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://custom.endpoint.co")
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://other.endpoint.co/api/refresh"
+
+
