+def test_mv_bucket_file_copies_then_deletes():
+    fs = _bucket_copy_fs()
+    with (
+        patch.object(fs, "info", return_value=_bucket_file_info("buckets/user/b1/.metadata.tmp")),
+        patch.object(fs, "expand_path", side_effect=lambda p, **kw: [fs._strip_protocol(p)]),
+        patch.object(fs, "isdir", return_value=False),
+        patch.object(fs, "exists", return_value=False),
+    ):
+        fs.mv("hf://buckets/user/b1/.metadata.tmp", "hf://buckets/user/b1/.metadata")
+    calls = fs._api.batch_bucket_files.call_args_list
+    assert calls[0].args == ("user/b1",)
+    assert calls[0].kwargs == {"copy": [("bucket", "user/b1", "abc123", ".metadata")]}
+    assert calls[-1].kwargs == {"delete": [".metadata.tmp"]}
