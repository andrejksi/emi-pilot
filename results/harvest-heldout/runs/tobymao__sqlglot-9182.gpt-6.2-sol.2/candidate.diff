diff --git a/tests/dialects/test_sqlite.py b/tests/dialects/test_sqlite.py
index b60ef60..cecffdc 100644
--- a/tests/dialects/test_sqlite.py
+++ b/tests/dialects/test_sqlite.py
@@ -1507,3 +1507,12 @@ class TestSQLite(Validator):
                     self.validate_all(sql, write={"sqlite": expected, "duckdb": expected})
                     expression = self.parse_one(sql).expressions[0]
                     self.assertIsInstance(expression.this if negate else expression, exp.Is)
+
+
+def test_sqlite_length_preserves_null_terminator_in_duckdb():
+    from sqlglot import transpile
+
+    target, = transpile("SELECT LENGTH('a' || CHAR(0) || 'b')", read="sqlite", write="duckdb")
+    assert "SPLIT_PART" in target and "CHR(0)" in target
+    blob, = transpile("SELECT LENGTH(X'610062')", read="sqlite", write="duckdb")
+    assert blob == "SELECT OCTET_LENGTH(UNHEX('610062'))"
