     assert only_hostname_with_path.http_scheme == constants.HTTP
 
 
+def test_http_scheme_inference():
+    # Scheme in host takes precedence over explicit http_scheme and port
+    assert Connection("https://mytrinoserver.domain", http_scheme=constants.HTTP).http_scheme == constants.HTTPS
+    assert Connection("http://mytrinoserver.domain", http_scheme=constants.HTTPS).http_scheme == constants.HTTP
+
+    # Explicit http_scheme takes precedence over port
+    assert Connection("mytrinoserver.domain", port=constants.DEFAULT_TLS_PORT,
+                      http_scheme=constants.HTTP).http_scheme == constants.HTTP
+    assert Connection("mytrinoserver.domain", port=constants.DEFAULT_PORT,
+                      http_scheme=constants.HTTPS).http_scheme == constants.HTTPS
+
+    # Scheme inferred from port
+    tls_port = Connection("mytrinoserver.domain", port=constants.DEFAULT_TLS_PORT)
+    assert tls_port.http_scheme == constants.HTTPS
+    assert tls_port.port == constants.DEFAULT_TLS_PORT
+
+    plain_port = Connection("mytrinoserver.domain", port=constants.DEFAULT_PORT)
+    assert plain_port.http_scheme == constants.HTTP
+    assert plain_port.port == constants.DEFAULT_PORT
+
+    # Unknown port falls back to http
+    other_port = Connection("mytrinoserver.domain", port=9999)
+    assert other_port.http_scheme == constants.HTTP
+    assert other_port.port == 9999
+
+    # No port and no scheme falls back to http
+    no_port = Connection("mytrinoserver.domain")
+    assert no_port.http_scheme == constants.HTTP
+    assert no_port.port == constants.DEFAULT_PORT
+
+
