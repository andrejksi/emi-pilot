diff --git a/tests/units/test_repro_tmp.py b/tests/units/test_repro_tmp.py
new file mode 100644
index 0000000..ed03c3e
--- /dev/null
+++ b/tests/units/test_repro_tmp.py
@@ -0,0 +1,54 @@
+import os
+from unittest import mock
+
+from tests.context import EOProduct, ProgressCallback
+from tests.units.test_download_plugins import BaseDownloadPluginTest
+
+
+class TestRepro(BaseDownloadPluginTest):
+    @mock.patch("eodag.plugins.download.http.HTTPDownload._stream_download", autospec=True)
+    @mock.patch("eodag.plugins.download.http.HTTPDownload.stream", create=True)
+    def test_twice(self, mock_stream, mock_stream_download):
+        product = EOProduct(
+            "meteoblue",
+            dict(geometry="POINT (0 0)", title="dummy_product", id="dummy"),
+        )
+        product.filename = "dummy_product.nc"
+        mock_stream_download.return_value = [b"a"]
+        plugin = self.get_download_plugin(product)
+        product.location = product.remote_location = "http://somewhere"
+        product.properties["id"] = "someproduct"
+        progress_callback = ProgressCallback(disable=True)
+
+        path = plugin.download(product, output_dir=self.output_dir, progress_callback=progress_callback)
+        print("first", path, os.listdir(self.output_dir))
+        # simulate a new search result: location back to remote
+        product.location = product.remote_location
+        path2 = plugin.download(product, output_dir=self.output_dir, progress_callback=progress_callback)
+        print("second", path2, os.listdir(self.output_dir))
+        print("calls", mock_stream_download.call_count)
+        assert mock_stream_download.call_count == 1, mock_stream_download.call_count
+        assert path == path2
+
+    @mock.patch("eodag.plugins.download.http.HTTPDownload._stream_download", autospec=True)
+    @mock.patch("eodag.plugins.download.http.HTTPDownload.stream", create=True)
+    def test_twice_zip(self, mock_stream, mock_stream_download):
+        product = EOProduct(
+            "peps",
+            dict(geometry="POINT (0 0)", title="dummy_product", id="dummy"),
+        )
+        product.filename = "dummy_product.zip"
+        mock_stream_download.return_value = [b"a"]
+        plugin = self.get_download_plugin(product)
+        product.location = product.remote_location = "http://somewhere"
+        product.properties["id"] = "someproduct"
+        progress_callback = ProgressCallback(disable=True)
+
+        path = plugin.download(product, output_dir=self.output_dir, progress_callback=progress_callback, extract=False)
+        print("first", path, os.listdir(self.output_dir))
+        product.location = product.remote_location
+        path2 = plugin.download(product, output_dir=self.output_dir, progress_callback=progress_callback, extract=False)
+        print("second", path2, os.listdir(self.output_dir))
+        print("calls", mock_stream_download.call_count)
+        assert mock_stream_download.call_count == 1, mock_stream_download.call_count
+        assert path == path2
