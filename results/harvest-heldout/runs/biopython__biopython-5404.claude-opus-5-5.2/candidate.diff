-        else:
-            crc = struct.pack("<I", crc)
+        return c.compress(block) + c.flush()
+
+    def _write_block(self, block):
+        """Write provided data to file as a single BGZF compressed block (PRIVATE).
+
+        If the data does not compress enough to fit in a single BGZF block,
+        only the first part of it is written, and the remainder which was
+        not written is returned (otherwise an empty bytes string).
+        """
+        # print("Saving %i bytes" % len(block))
+        if len(block) > _BGZF_BLOCK_SIZE:
+            raise ValueError(f"{len(block)} Block length > {_BGZF_BLOCK_SIZE}")
+        compressed = self._compress(block)
+        rest = b""
+        if len(compressed) > _BGZF_MAX_COMPRESSED:
+            # Didn't compress enough, so write less data in this block.
+            # Cutting at _BGZF_SAFE_BLOCK_SIZE keeps any virtual offsets
+            # already given out by tell() valid (see tell).
+            rest = block[_BGZF_SAFE_BLOCK_SIZE:]
+            block = block[:_BGZF_SAFE_BLOCK_SIZE]
+            compressed = self._compress(block)
+            if len(compressed) > _BGZF_MAX_COMPRESSED:
+                # Should not be possible, deflate's worst case is smaller
+                raise RuntimeError(
+                    f"{len(block)} bytes compressed to {len(compressed)} "
+                    "bytes, too large for a BGZF block"
+                )
         bsize = struct.pack("<H", len(compressed) + 25)  # includes -1
         crc = struct.pack("<I", zlib.crc32(block) & 0xFFFFFFFF)
         uncompressed_length = struct.pack("<I", len(block))
