-        converter = abstract_inline_conversion(lambda self: '`')
-        return converter(self, el, text, parent_tags)
+        if '_noformat' in parent_tags:
+            return text
+        prefix, suffix, text = chomp(text)
+        if not text:
+            return ''
+        # Use a delimiter of backticks longer than any run of backticks in the
+        # text, so that backticks inside the code span are preserved.
+        longest_run = max((len(m) for m in re.findall(r'`+', text)), default=0)
+        delimiter = '`' * (longest_run + 1)
+        # Pad with spaces if the text starts or ends with a backtick, so that
+        # the delimiters are not merged with the content.
+        if text[0] == '`' or text[-1] == '`':
+            text = ' %s ' % text
+        return '%s%s%s%s%s' % (prefix, delimiter, text, delimiter, suffix)
 
