+def test_parse_valid_headers_file_info_custom_endpoint() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": f"{constants.HUGGINGFACE_CO_URL_HOME}api/models/username/repo_name/xet-read-token/token",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response, endpoint="https://custom.endpoint")
+
+    assert file_data is not None
+    assert file_data.refresh_route == "https://custom.endpoint/api/models/username/repo_name/xet-read-token/token"
+    assert file_data.file_hash == "sha256:abcdef"
+
+
+def test_parse_valid_headers_file_info_default_endpoint() -> None:
+    mock_response = MagicMock()
+    mock_response.headers = {
+        "X-Xet-Hash": "sha256:abcdef",
+        "X-Xet-Refresh-Route": f"{constants.HUGGINGFACE_CO_URL_HOME}api/models/username/repo_name/xet-read-token/token",
+    }
+    mock_response.links = {}
+
+    file_data = parse_xet_file_data_from_response(mock_response)
+
+    assert file_data is not None
+    assert file_data.refresh_route == f"{constants.ENDPOINT}/api/models/username/repo_name/xet-read-token/token"
+
+
