+def test_copy_bucket_file_uses_server_side_copy():
+    fs = HfFileSystem()
+    source = "buckets/username/my_bucket/folder/upload.tmp"
+    destination = "buckets/username/my_bucket/folder/upload"
+    fs.dircache["buckets/username/my_bucket/folder"] = []
+    with (
+        mock_bucket_info(fs),
+        patch.object(fs._api, "get_bucket_paths_info", return_value=[Mock(xet_hash="source-hash")]),
+        patch.object(fs._api, "batch_bucket_files") as batch,
+    ):
+        fs.cp_file(source, destination)
+
+    batch.assert_called_once_with(
+        "username/my_bucket",
+        copy=[("bucket", "username/my_bucket", "source-hash", "folder/upload")],
+    )
+    assert "buckets/username/my_bucket/folder" not in fs.dircache
