+def _bucket_copy_fs():
+    fs = HfFileSystem(skip_instance_cache=True)
+    fs._api = Mock()
+    fs._api.bucket_info.return_value = None
+    return fs
+
+
+def _bucket_file_info(name: str, xet_hash: str | None = "abc123") -> dict:
+    return {"name": name, "size": 3, "type": "file", "xet_hash": xet_hash}
+
+
+def test_cp_file_bucket_to_bucket_is_server_side():
+    fs = _bucket_copy_fs()
+    with patch.object(fs, "info", return_value=_bucket_file_info("buckets/user/b1/a.txt")) as info:
+        fs.cp_file("hf://buckets/user/b1/a.txt", "hf://buckets/user/b2/dir/b.txt")
+    info.assert_called_once_with("buckets/user/b1/a.txt", refresh=True)
+    fs._api.batch_bucket_files.assert_called_once_with("user/b2", copy=[("bucket", "user/b1", "abc123", "dir/b.txt")])
+
+
+def test_cp_file_repo_to_bucket_uses_xet_hash():
+    fs = _bucket_copy_fs()
+    fs._repo_and_revision_exists = Mock(return_value=(True, None))
+    with patch.object(fs, "info", return_value=_bucket_file_info("datasets/user/repo/a.txt")):
+        fs.cp_file("hf://datasets/user/repo/a.txt", "hf://buckets/user/b1/a.txt")
+    fs._api.batch_bucket_files.assert_called_once_with("user/b1", copy=[("dataset", "user/repo", "abc123", "a.txt")])
+
+
+def test_cp_file_repo_to_bucket_without_xet_hash_uploads_content():
+    fs = _bucket_copy_fs()
+    fs._repo_and_revision_exists = Mock(return_value=(True, None))
+    file = Mock()
+    file.__enter__ = Mock(return_value=file)
+    file.__exit__ = Mock(return_value=False)
+    file.read.return_value = b"abc"
+    with (
+        patch.object(fs, "info", return_value=_bucket_file_info("datasets/user/repo/a.txt", xet_hash=None)),
+        patch.object(fs, "open", return_value=file),
+    ):
+        fs.cp_file("hf://datasets/user/repo/a.txt", "hf://buckets/user/b1/a.txt")
+    fs._api.batch_bucket_files.assert_called_once_with("user/b1", add=[(b"abc", "a.txt")])
+
+
+def test_cp_file_bucket_to_repo_uploads_content():
+    fs = _bucket_copy_fs()
+    fs._repo_and_revision_exists = Mock(return_value=(True, None))
+    file = Mock()
+    file.__enter__ = Mock(return_value=file)
+    file.__exit__ = Mock(return_value=False)
+    file.read.return_value = b"abc"
+    with (
+        patch.object(fs, "info", return_value=_bucket_file_info("buckets/user/b1/a.txt")),
+        patch.object(fs, "open", return_value=file),
+    ):
+        fs.cp_file("hf://buckets/user/b1/a.txt", "hf://datasets/user/repo/a.txt")
+    fs._api.batch_bucket_files.assert_not_called()
+    fs._api.upload_file.assert_called_once()
+    kwargs = fs._api.upload_file.call_args.kwargs
+    assert kwargs["path_or_fileobj"] == b"abc"
+    assert kwargs["repo_id"] == "user/repo"
+    assert kwargs["repo_type"] == "dataset"
+    assert kwargs["path_in_repo"] == "a.txt"
+
+
+def test_cp_file_bucket_directory_is_noop():
+    fs = _bucket_copy_fs()
+    with patch.object(fs, "info", return_value={"name": "buckets/user/b1/dir", "size": 0, "type": "directory"}):
+        fs.cp_file("hf://buckets/user/b1/dir", "hf://buckets/user/b1/dir2")
+    fs._api.batch_bucket_files.assert_not_called()
