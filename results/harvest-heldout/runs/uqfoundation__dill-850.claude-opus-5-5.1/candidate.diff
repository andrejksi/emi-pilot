+def test_load_closes_file_on_failure():
+  import tempfile, os
+  with tempfile.NamedTemporaryFile(suffix='.pkl', delete=False) as f:
+    f.write(b'not a pickle')
+  try:
+    errors = []
+    opened = []
+    import builtins
+    real_open = builtins.open
+    def tracking_open(*args, **kwds):
+      fh = real_open(*args, **kwds)
+      opened.append(fh)
+      return fh
+    builtins.open = tracking_open
+    try:
+      for _ in range(5):
+        try:
+          dill.temp.load(f.name)
+        except Exception as error:
+          errors.append(error)
+    finally:
+      builtins.open = real_open
+    assert len(errors) == 5
+    # the original unpickling error is preserved, not replaced by an I/O error
+    assert all(isinstance(e, dill.UnpicklingError) for e in errors)
+    assert opened and all(fh.closed for fh in opened)
+  finally:
+    os.remove(f.name)
+
+def test_load_closes_file_on_success():
+  dumpfile = dill.temp.dump([1, 2, 3])
+  import builtins
+  opened = []
+  real_open = builtins.open
+  def tracking_open(*args, **kwds):
+    fh = real_open(*args, **kwds)
+    opened.append(fh)
+    return fh
+  builtins.open = tracking_open
+  try:
+    assert dill.temp.load(dumpfile) == [1, 2, 3]
+  finally:
+    builtins.open = real_open
+  assert opened and all(fh.closed for fh in opened)
+
 
 if __name__ == '__main__':
+    test_load_closes_file_on_failure()
+    test_load_closes_file_on_success()
