+def test_code_with_backticks():
+    assert md('<code>We have to `manage` this.</code>') == '``We have to `manage` this.``'
+    assert md('<code>`foo`</code>') == '`` `foo` ``'
+    assert md('<code>foo``bar</code>') == '```foo``bar```'
+    assert md('<kbd>We have to `manage` this.</kbd>') == '``We have to `manage` this.``'
+    assert md('<samp>We have to `manage` this.</samp>') == '``We have to `manage` this.``'
+    assert md('foo <code>a `b` c</code> bar') == 'foo ``a `b` c`` bar'
+    assert md('<code>foo<code>bar `baz`</code></code>') == '`` foobar `baz` ``'
+    assert md('<pre><code>foo `bar`</code></pre>') == '\n\n```\nfoo `bar`\n```\n\n'
+
+
 def test_dl():
