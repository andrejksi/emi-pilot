+    def check_incompressible(self, size, compresslevel=6):
+        data = random.Random(size).randbytes(size)
+        with bgzf.BgzfWriter(
+            self.temp_file, mode="wb", compresslevel=compresslevel
+        ) as w:
+            w.write(data)
+        with open(self.temp_file, "rb") as handle:
+            raw = handle.read()
+        handle = io.BytesIO(raw)
+        blocks = list(bgzf.BgzfBlocks(handle))
+        # Each block (including its header) must fit in 65536 bytes:
+        for raw_start, raw_len, data_start, data_len in blocks:
+            self.assertLessEqual(raw_len, 65536)
+            self.assertLessEqual(data_len, 65536)
+        self.assertEqual(sum(b[3] for b in blocks), size)
+        with bgzf.BgzfReader(self.temp_file, mode="rb") as r:
+            self.assertEqual(r.read(size + 1), data)
+        # Standard gzip should also be able to read it:
+        self.assertEqual(gzip.decompress(raw), data)
+
+    def test_write_incompressible(self):
+        """Check writing data which does not compress, e.g. random bytes."""
+        for size in (0, 1, 1000, 65490, 65491, 65500, 65516, 65517, 65535, 65536):
+            with self.subTest(size=size):
+                self.check_incompressible(size)
+        # Multiple blocks worth:
+        self.check_incompressible(3 * 65536 + 123)
+
+    def test_write_incompressible_level0(self):
+        """Check writing with compression level zero (stored blocks)."""
+        for size in (65500, 65536, 2 * 65536 + 7):
+            with self.subTest(size=size):
+                self.check_incompressible(size, compresslevel=0)
+
+    def check_tell_seek(self, data, chunk):
+        offsets = []
+        with bgzf.BgzfWriter(self.temp_file, mode="wb") as w:
+            for i in range(0, len(data), chunk):
+                offsets.append((w.tell(), i))
+                w.write(data[i : i + chunk])
+            offsets.append((w.tell(), len(data)))
+        with bgzf.BgzfReader(self.temp_file, mode="rb") as r:
+            for voffset, i in offsets:
+                r.seek(voffset)
+                self.assertEqual(r.read(chunk), data[i : i + chunk])
+        with open(self.temp_file, "rb") as handle:
+            for raw_start, raw_len, data_start, data_len in bgzf.BgzfBlocks(handle):
+                self.assertLessEqual(raw_len, 65536)
+
+    def test_write_incompressible_tell_seek(self):
+        """Check virtual offsets remain valid with incompressible data."""
+        rand = random.Random(1).randbytes(3 * 65536)
+        for chunk in (4096, 1000, 100, 7):
+            with self.subTest(chunk=chunk):
+                self.check_tell_seek(rand, chunk)
+        # Compressible data followed by incompressible data
+        mixed = b"ACGT" * 20000 + rand + b"N" * 70000 + rand
+        for chunk in (5000, 99):
+            with self.subTest(chunk=chunk, mixed=True):
+                self.check_tell_seek(mixed, chunk)
+
