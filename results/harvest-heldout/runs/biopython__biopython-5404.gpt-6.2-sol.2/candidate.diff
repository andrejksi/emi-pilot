+            midpoint = len(block) // 2
+            self._write_block(block[:midpoint])
+            self._write_block(block[midpoint:])
+            return
         bsize = struct.pack("<H", len(compressed) + 25)  # includes -1
         crc = struct.pack("<I", zlib.crc32(block) & 0xFFFFFFFF)
         uncompressed_length = struct.pack("<I", len(block))
diff --git a/Tests/test_bgzf.py b/Tests/test_bgzf.py
index 7d62927..1188274 100644
--- a/Tests/test_bgzf.py
+++ b/Tests/test_bgzf.py
@@ -520,3 +520,17 @@ class BgzfTests(unittest.TestCase):
 if __name__ == "__main__":
     runner = unittest.TextTestRunner(verbosity=2)
     unittest.main(testRunner=runner)
+
+
+def test_incompressible_bgzf_data(tmp_path):
+    import random
+
+    from Bio import bgzf
+
+    for size in (65500, 65536):
+        data = random.Random(42).randbytes(size)
+        filename = tmp_path / f"{size}.bgz"
+        with bgzf.BgzfWriter(filename=filename, mode="wb") as writer:
+            writer.write(data)
+        with bgzf.BgzfReader(filename=filename, mode="rb") as reader:
+            assert reader.read(size) == data
