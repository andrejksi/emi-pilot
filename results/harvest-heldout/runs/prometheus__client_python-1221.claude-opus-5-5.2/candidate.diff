+    def test_non_string_label_values_are_coerced(self):
+        families = [
+            GaugeMetricFamily('g', 'help', labels=['a']),
+            CounterMetricFamily('c', 'help', labels=['a']),
+            UntypedMetricFamily('u', 'help', labels=['a']),
+        ]
+        for f in families:
+            f.add_metric([1], 2)
+        s = SummaryMetricFamily('s', 'help', labels=['a'])
+        s.add_metric([1], count_value=1, sum_value=2)
+        h = HistogramMetricFamily('h', 'help', labels=['a'])
+        h.add_metric([1], buckets=[('+Inf', 1)], sum_value=2)
+        i = InfoMetricFamily('i', 'help', labels=['a'])
+        i.add_metric([1], {'b': 'c'})
+        ss = StateSetMetricFamily('ss', 'help', labels=['a'])
+        ss.add_metric([1], {'x': True})
+        for f in families + [s, h, i, ss]:
+            for sample in f.samples:
+                self.assertEqual('1', sample.labels['a'])
+        self.custom_collector(families[0])
+        self.assertEqual(2, self.registry.get_sample_value('g', {'a': '1'}))
+        self.assertIn(b'g{a="1"} 2.0', generate_latest(self.registry))
+
     def test_summary(self):
         self.custom_collector(SummaryMetricFamily('s', 'help', count_value=1, sum_value=2))
         self.assertEqual(1, self.registry.get_sample_value('s_count', {}))
