+@pytest.mark.parametrize("keepStaleElidedNameID", [False, True])
+def test_updateNameTable_stat_version_1_0(varfont, keepStaleElidedNameID):
+    # STAT version 1.0 has no ElidedFallbackNameID; the subfamily name (nameID 2)
+    # is used as the fallback instead.
+    stat = varfont["STAT"].table
+    stat.Version = 0x00010000
+    if keepStaleElidedNameID:
+        # a value that is not part of a version 1.0 table must be ignored
+        stat.ElidedFallbackNameID = 30564
+    else:
+        del stat.ElidedFallbackNameID
+
+    instancer.names.updateNameTable(varfont, {"wght": 900})
+    expected = {
+        (1, 3, 1, 0x409): "Test Variable Font Black",
+        (2, 3, 1, 0x409): "Regular",
+        (16, 3, 1, 0x409): "Test Variable Font",
+        (17, 3, 1, 0x409): "Black",
+    }
+    _test_name_records(varfont, expected, isNonRIBBI=True)
+
+
+def test_updateNameTable_stat_version_1_0_elided_axisValues(varfont):
+    stat = varfont["STAT"].table
+    stat.Version = 0x00010000
+    del stat.ElidedFallbackNameID
+    for axisValue in stat.AxisValueArray.AxisValue:
+        axisValue.Flags |= instancer.names.ELIDABLE_AXIS_VALUE_NAME
+    varfont["name"].setName("Bold", 2, 3, 1, 0x409)
+
+    instancer.names.updateNameTable(varfont, {"wght": 400})
+    expected = {(2, 3, 1, 0x409): "Bold"}
+    _test_name_records(varfont, expected, isNonRIBBI=False)
+
+
+def test_instantiateVariableFont_stat_version_1_0(varfont):
+    stat = varfont["STAT"].table
+    stat.Version = 0x00010000
+    del stat.ElidedFallbackNameID
+
+    instance = instancer.instantiateVariableFont(
+        varfont, {"wght": 900, "wdth": 100}, updateFontNames=True
+    )
+    expected = {
+        (1, 3, 1, 0x409): "Test Variable Font Black",
+        (2, 3, 1, 0x409): "Regular",
+        (16, 3, 1, 0x409): "Test Variable Font",
+        (17, 3, 1, 0x409): "Black",
+    }
+    _test_name_records(instance, expected, isNonRIBBI=True)
+
+
