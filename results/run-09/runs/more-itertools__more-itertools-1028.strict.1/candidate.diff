+    def test_reversed_is_none(self):
+        # ``Mapping`` sets ``__reversed__`` to ``None``, which should not be
+        # treated as a reversible sequence.
+        class MyMapping(abc.Mapping):
+            def __getitem__(self, key):
+                return 1
+
+            def __iter__(self):
+                return iter([1])
+
+            def __len__(self):
+                return 1
+
+        class EmptyMapping(MyMapping):
+            def __iter__(self):
+                return iter([])
+
+            def __len__(self):
+                return 0
+
+        self.assertEqual(mi.last(MyMapping()), 1)
+        self.assertEqual(mi.last(EmptyMapping(), 'default'), 'default')
+        with self.assertRaises(ValueError):
+            mi.last(EmptyMapping())
+
 
