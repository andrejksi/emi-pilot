+def _launcher_extensions(conanfile, subsystem):
+    """ The extensions of the launchers to generate when the caller did not give one.
+    PowerShell launchers replace the .bat ones, unless "tools.env.virtualenv:bat" asks to
+    keep the .bat ones too (for scripts that activate the environment from CMD)
+    """
+    is_bat = subsystem == WINDOWS
+    if conanfile.conf.get("tools.env.virtualenv:powershell", check_type=str):
+        if is_bat and _bat_with_powershell(conanfile):
+            return [".bat", ".ps1"]
+        return [".ps1"]
+    return [".bat"] if is_bat else [".sh"]
+
+
+def _bat_with_powershell(conanfile):
+    return conanfile.conf.get("tools.env.virtualenv:bat", default=False, check_type=bool)
 
 
