+@pytest.mark.parametrize("predeclare", [False, True])
+def test_scan_preserves_detector_order(RE, hw, predeclare, monkeypatch):
+    if predeclare:
+        monkeypatch.setenv("BLUESKY_PREDECLARE", "1")
+
+    detectors = [hw.det3, hw.det1, hw.det2]
+    docs = defaultdict(list)
+    RE(scan(detectors, hw.motor, -1, 1, 2), lambda name, doc: docs[name].append(doc))
+
+    (descriptor,) = docs["descriptor"]
+    expected_detector_keys = [det.name for det in detectors]
+    expected_keys = expected_detector_keys + list(hw.motor.describe())
+
+    assert list(descriptor["data_keys"]) == expected_keys
+    assert list(descriptor["object_keys"]) == expected_detector_keys + [hw.motor.name]
+    assert docs["event"]
+    for event in docs["event"]:
+        assert list(event["data"]) == expected_keys
+        assert list(event["timestamps"]) == expected_keys
+
