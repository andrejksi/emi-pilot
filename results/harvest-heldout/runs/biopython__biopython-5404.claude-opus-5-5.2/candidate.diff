     def tell(self):
         """Return a BGZF 64-bit virtual offset."""
+        if len(self._buffer) >= _BGZF_SAFE_BLOCK_SIZE:
+            # If the buffered block turns out not to compress enough, it
+            # will be cut after _BGZF_SAFE_BLOCK_SIZE bytes, and an offset
+            # past that point would be invalid. Write those bytes out now
+            # as their own block, which always fits.
+            self._write_block(self._buffer[:_BGZF_SAFE_BLOCK_SIZE])
+            self._buffer = self._buffer[_BGZF_SAFE_BLOCK_SIZE:]
         return make_virtual_offset(self._handle.tell(), len(self._buffer))
 
     def seekable(self):
diff --git a/Tests/test_bgzf.py b/Tests/test_bgzf.py
index 7d62927..f37b9ee 100644
--- a/Tests/test_bgzf.py
+++ b/Tests/test_bgzf.py
@@ -13,6 +13,7 @@ import io
 import os
 import tempfile
 import unittest
+import random
 from random import shuffle
 
 from Bio import bgzf
@@ -517,6 +518,78 @@ class BgzfTests(unittest.TestCase):
             bgzf.BgzfWriter(fileobj=handle)
 
 
+    def check_incompressible(self, size, write_sizes=None):
+        """Write random (incompressible) data and check it reads back."""
+        data = random.Random(size).randbytes(size)
+        with bgzf.BgzfWriter(self.temp_file, "wb") as writer:
+            if write_sizes is None:
+                writer.write(data)
+            else:
+                start = 0
+                for chunk in write_sizes:
+                    writer.write(data[start : start + chunk])
+                    start += chunk
+                writer.write(data[start:])
+        with open(self.temp_file, "rb") as handle:
+            blocks = list(bgzf.BgzfBlocks(handle))
+        for _, raw_length, _, data_length in blocks:
+            self.assertLessEqual(raw_length, 65536)
+            self.assertLessEqual(data_length, 65536)
+        self.assertEqual(sum(b[3] for b in blocks), size)
+        with bgzf.BgzfReader(self.temp_file, "rb") as reader:
+            self.assertEqual(reader.read(size + 1), data)
+        with gzip.open(self.temp_file, "rb") as handle:
+            self.assertEqual(handle.read(), data)
+
+    def test_incompressible_full_block(self):
+        """Random data filling a whole block must be written correctly."""
+        self.check_incompressible(65536)
+
+    def test_incompressible_near_full_block(self):
+        """Random data just under a block (BSIZE overflow) must be written."""
+        for size in (65491, 65500, 65510, 65516, 65517, 65535):
+            with self.subTest(size=size):
+                self.check_incompressible(size)
+
+    def test_incompressible_many_blocks(self):
+        """Several blocks of random data, written in pieces, must round trip."""
+        self.check_incompressible(300000, write_sizes=[1, 70000, 65535, 100])
+
+    def test_incompressible_all_levels(self):
+        """Random data must be written at every compression level."""
+        data = random.Random(0).randbytes(140000)
+        for level in range(10):
+            with self.subTest(compresslevel=level):
+                with bgzf.BgzfWriter(self.temp_file, "wb", compresslevel=level) as w:
+                    w.write(data)
+                with gzip.open(self.temp_file, "rb") as handle:
+                    self.assertEqual(handle.read(), data)
+
+    def test_incompressible_virtual_offsets(self):
+        """Virtual offsets from tell() must be usable with incompressible data."""
+        data = random.Random(1).randbytes(200000)
+        offsets = []
+        with bgzf.BgzfWriter(self.temp_file, "wb") as writer:
+            for i in range(0, len(data), 10000):
+                offsets.append((i, writer.tell()))
+                writer.write(data[i : i + 10000])
+        with bgzf.BgzfReader(self.temp_file, "rb") as reader:
+            for i, offset in offsets:
+                reader.seek(offset)
+                self.assertEqual(reader.read(100), data[i : i + 100])
+
+    def test_incompressible_tell_late_in_block(self):
+        """An offset from tell() late in a block must survive a block split."""
+        data = random.Random(2).randbytes(200000)
+        with bgzf.BgzfWriter(self.temp_file, "wb") as writer:
+            writer.write(data[:65400])
+            offset = writer.tell()
+            writer.write(data[65400:])
+        with bgzf.BgzfReader(self.temp_file, "rb") as reader:
+            reader.seek(offset)
+            self.assertEqual(reader.read(1000), data[65400:66400])
+
+
 if __name__ == "__main__":
