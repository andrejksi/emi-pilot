+    def test_naive_datetime_is_utc(self):
+        future = datetime.now(timezone.utc) + timedelta(hours=1)
+        aware = to_timestamp(future, time=lambda: 0.0)
+        naive = to_timestamp(future.replace(tzinfo=None), time=lambda: 0.0)
+        assert naive == pytest.approx(aware, abs=1.0)
+
+    def test_import_without_tz_database(self, tmp_path):
+        # Simulate a host with no OS tz data and no tzdata package: the
+        # timer module must still import, since UTC needs no database.
+        code = (
+            "import sys; sys.modules['tzdata'] = None\n"
+            "import kombu.asynchronous.timer as t\n"
+            "assert t.to_timestamp(t.datetime(2030, 1, 1)) > 0\n"
+        )
+        env = dict(os.environ, PYTHONTZPATH=str(tmp_path))
+        subprocess.run([sys.executable, "-c", code], env=env, check=True)
