+@pytest.mark.parametrize("predeclare", [False, True])
+def test_scan_preserves_detector_order(RE, hw, monkeypatch, predeclare):
+    if predeclare:
+        monkeypatch.setenv("BLUESKY_PREDECLARE", "1")
+
+    detectors = [hw.det4, hw.det1, hw.det3, hw.det2]
+    documents = []
+    RE(bp.scan(detectors, hw.motor, -1, 1, 2), lambda name, doc: documents.append((name, doc)))
+
+    descriptor = next(doc for name, doc in documents if name == "descriptor")
+    events = [doc for name, doc in documents if name == "event"]
+    detector_keys = [det.name for det in detectors]
+    motor_keys = list(hw.motor.describe())
+    expected_keys = detector_keys + motor_keys
+
+    if predeclare:
+        assert list(descriptor["object_keys"]) == [hw.motor.name] + detector_keys
+        assert list(descriptor["data_keys"]) == motor_keys + detector_keys
+    else:
+        assert list(descriptor["object_keys"]) == detector_keys + [hw.motor.name]
+        assert list(descriptor["data_keys"]) == expected_keys
+    assert len(events) == 2
+    for event in events:
+        assert list(event["data"]) == expected_keys
+        assert list(event["timestamps"]) == expected_keys
+
+
