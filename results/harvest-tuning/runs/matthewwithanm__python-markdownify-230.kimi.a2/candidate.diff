diff --git a/markdownify/__init__.py b/markdownify/__init__.py
index 72c5214..757d575 100644
--- a/markdownify/__init__.py
+++ b/markdownify/__init__.py
@@ -482,8 +482,23 @@ class MarkdownConverter(object):
     def convert_code(self, el, text, parent_tags):
         if 'pre' in parent_tags:
             return text
-        converter = abstract_inline_conversion(lambda self: '`')
-        return converter(self, el, text, parent_tags)
+        if '_noformat' in parent_tags:
+            return text
+
+        prefix, suffix, text = chomp(text)
+        if not text:
+            return ''
+
+        # Use a delimiter longer than any backtick run in the code so that
+        # backticks in the code cannot accidentally close the code span.
+        backtick_runs = re.findall(r'`+', text)
+        delimiter = '`' * (max(map(len, backtick_runs), default=0) + 1)
+
+        # Markdown requires padding when the code starts or ends with a
+        # backtick; otherwise that backtick would become part of the delimiter.
+        padding = ' ' if text.startswith('`') or text.endswith('`') else ''
+        return '%s%s%s%s%s%s%s' % (
+            prefix, delimiter, padding, text, padding, delimiter, suffix)
 
     convert_del = abstract_inline_conversion(lambda self: '~~')
 
