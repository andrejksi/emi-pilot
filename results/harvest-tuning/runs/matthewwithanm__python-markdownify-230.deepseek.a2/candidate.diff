-        converter = abstract_inline_conversion(lambda self: '`')
+
+        # Use a backtick fence that is longer than any run of backticks in the
+        # text, so that backticks inside the code span are preserved.
+        longest_backtick_run = max((len(m) for m in re.findall(r'`+', text)), default=0)
+        fence = '`' * (longest_backtick_run + 1)
+
+        # If the text starts or ends with a backtick, or consists only of
+        # backticks, pad it with spaces so the fence is not ambiguous.
+        # (Padding is applied after chomping, so it is not stripped away.)
+        if text.startswith('`') or text.endswith('`') or not text.strip('`'):
+            prefix, suffix, text = chomp(text)
+            if not text:
+                return ''
+            return '%s%s %s %s%s' % (prefix, fence, text, fence, suffix)
+
+        converter = abstract_inline_conversion(lambda self: fence)
         return converter(self, el, text, parent_tags)
 
