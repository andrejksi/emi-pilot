+    def test_crunch_filterdate_datetime_only(self):
+        """Crunch FilterDate must use datetime for products without start/end dates"""
+        search_results = self.__fake_search_result(
+            [
+                {"datetime": "2021-02-14T10:51:31Z"},
+                {"datetime": "2021-02-12T11:00:59Z"},
+                {
+                    "datetime": "2021-02-14T10:51:31Z",
+                    "start_datetime": "2021-02-11T00:00:00Z",
+                    "end_datetime": "2021-02-11T12:00:00Z",
+                },
+            ]
+        )
+        filtered_result = search_results.crunch(
+            FilterDate(dict(start="2021-02-10T00:00:00", end="2021-02-12T00:00:00"))
+        )
+        self.assertEqual(len(filtered_result), 1)
+        self.assertEqual(
+            filtered_result[0].properties["start_datetime"], "2021-02-11T00:00:00Z"
+        )
+
+        filtered_result = search_results.crunch(
+            FilterDate(dict(start="2021-02-10T00:00:00", end="2021-02-13T00:00:00"))
+        )
