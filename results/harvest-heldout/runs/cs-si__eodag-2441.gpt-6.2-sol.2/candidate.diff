+def test_filter_date_uses_stac_instant():
+    from types import SimpleNamespace
+
+    from eodag.plugins.crunch.filter_date import FilterDate
+
+    outside = SimpleNamespace(properties={"datetime": "2021-02-13T00:00:00Z"})
+    inside = SimpleNamespace(properties={"datetime": "2021-02-11T00:00:00Z"})
+    crunch = FilterDate({"start": "2021-02-10", "end": "2021-02-12"})
+
+    assert crunch.proceed([outside, inside]) == [inside]
