+def _as_content_list(content: str | list[dict[str, Any]] | None) -> list[dict[str, Any]]:
+    """Returns message content as a list of content elements."""
+    if content is None:
+        return []
+    if isinstance(content, str):
+        return [{"type": "text", "text": content}]
+    return content
+
+
+def _merge_message_content(
+    previous_message: dict[str, Any],
+    content: str | list[dict[str, Any]] | None,
+    flatten_messages_as_text: bool,
+) -> None:
+    """Merges `content` into `previous_message`, which has the same role."""
+    if content is None or content == [] or content == "":
+        return
+    previous_content = previous_message["content"]
+    if flatten_messages_as_text:
+        new_text = content if isinstance(content, str) else content[0]["text"]
+        if previous_content is None or previous_content == "":
+            previous_message["content"] = new_text
+        else:
+            previous_message["content"] = previous_content + "\n" + new_text
+        return
+    if isinstance(previous_content, str) and isinstance(content, str):
+        previous_message["content"] = (previous_content + "\n" + content) if previous_content else content
+        return
+    merged = list(_as_content_list(previous_content))
+    for el in _as_content_list(content):
+        if el["type"] == "text" and merged and merged[-1]["type"] == "text":
+            # Merge consecutive text messages rather than creating new ones
+            merged[-1] = {**merged[-1], "text": merged[-1]["text"] + "\n" + el["text"]}
+        else:
+            merged.append(el)
+    previous_message["content"] = merged
+
+
