+# Uncompressed data per BGZF block when writing. Like bgzip, we fill blocks
+# with 65536 bytes, which gives the same blocks as older bgzip versions.
+_BGZF_BLOCK_SIZE = 65536
+
+# The block size (BSIZE, less one) is stored in an unsigned 16-bit field
+# and each block has 26 bytes of header and footer, so the compressed data
+# can be at most this many bytes:
+_BGZF_MAX_COMPRESSED = 0xFFFF - 25
+
+# Data which does not compress (e.g. random or already compressed data)
+# expands slightly under deflate, so 65536 such bytes do not fit in one
+# block. Blocks of at most this many bytes always fit (htslib also limits
+# blocks to 0xff00 bytes), so a block which does not fit is cut to this:
+_BGZF_SAFE_BLOCK_SIZE = 0xFF00
+
