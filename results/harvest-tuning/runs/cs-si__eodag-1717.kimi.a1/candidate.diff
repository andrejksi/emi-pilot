+    @mock.patch("eodag.plugins.download.http.requests.Session.request", autospec=True)
+    def test_plugins_download_http_already_downloaded_zip_file(
+        self, mock_requests_session
+    ):
+        """HTTPDownload.download() must not download an existing archive again"""
+
+        provider = "geodes"
+        product_type = "S2_MSI_L1C"
+        product_id = "S2A_MSIL1C_20231006T102911_N0509_R108_T31TFK_20231006T141008"
+        local_product_as_archive_path = os.path.join(
+            TEST_RESOURCES_PATH,
+            "products",
+            "as_archive",
+            "S2A_MSIL1C_20180101T105441_N0206_R051_T31TDH_20180101T124911.zip",
+        )
+        properties = {
+            "id": product_id,
+            "title": product_id,
+            "geometry": "POINT (0 0)",
+            "downloadLink": "https://foo.bar/download",
+        }
+        product = self._dummy_downloadable_product(
+            mock_requests_session,
+            local_product_as_archive_path,
+            provider,
+            properties,
+            product_type,
+        )
+
+        path = product.download()
+        self.assertEqual(path, os.path.join(self.output_dir, product_id + ".zip"))
+        self.assertEqual(mock_requests_session.call_count, 1)
+
+        # Simulate a new search result for the same product in a later execution.
+        new_product = self._dummy_product(provider, properties, product_type)
+        new_product.register_downloader(product.downloader, None)
+        new_path = new_product.download()
+
+        self.assertEqual(new_path, path)
+        self.assertEqual(mock_requests_session.call_count, 1)
+
