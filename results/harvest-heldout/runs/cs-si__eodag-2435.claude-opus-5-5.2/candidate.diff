+    @staticmethod
+    def _check_dates_validity(start: Any = None, end: Any = None) -> None:
+        """Check that the given search dates are valid, before sending any request.
+
+        :param start: (optional) Start date of the search
+        :param end: (optional) End date of the search
+        :raises ValidationError: If a date cannot be parsed or if start is after end
+        """
+        parsed: dict[str, dt.datetime] = {}
+        for name, value in (("start", start), ("end", end)):
+            if value is None or value == "":
+                continue
+            if isinstance(value, dt.datetime):
+                parsed[name] = (
+                    value.replace(tzinfo=dt.timezone.utc)
+                    if value.tzinfo is None
+                    else value.astimezone(dt.timezone.utc)
+                )
+                continue
+            if isinstance(value, dt.date):
+                parsed[name] = dt.datetime(
+                    value.year, value.month, value.day, tzinfo=dt.timezone.utc
+                )
+                continue
+            if not isinstance(value, str):
+                raise ValidationError(
+                    f"Invalid {name} date: {value!r}", {f"{name}_datetime"}
+                )
+            try:
+                parsed[name] = parse_to_utc(value)
+            except ValidationError as e:
+                raise ValidationError(
+                    f"Invalid {name} date: {value!r}", {f"{name}_datetime"}
+                ) from e
+        if "start" in parsed and "end" in parsed and parsed["start"] > parsed["end"]:
+            raise ValidationError(
+                f"Start date {start!r} must not be after end date {end!r}",
+                {"start_datetime", "end_datetime"},
+            )
+
