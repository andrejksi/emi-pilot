diff --git a/Tests/ttLib/ttGlyphSet_test.py b/Tests/ttLib/ttGlyphSet_test.py
index 906489f..831ea6e 100644
--- a/Tests/ttLib/ttGlyphSet_test.py
+++ b/Tests/ttLib/ttGlyphSet_test.py
@@ -511,6 +511,27 @@ class TTGlyphSetTest(object):
         getattr(glyphset[glyph_name], draw)(pen)
         assert pen.value == expected
 
+    @pytest.mark.parametrize("location", [{"wght": 1000}, {"wght": 300}])
+    def test_glyphset_cff2_from_ttx_varies(self, location):
+        fontFromOTF = TTFont(self.getpath("I.otf"))
+        stream = StringIO()
+        fontFromOTF.saveXML(stream)
+        stream.seek(0)
+        fontFromTTX = TTFont()
+        fontFromTTX.importXML(stream)
+
+        topDict = fontFromTTX["CFF2"].cff.topDictIndex[0]
+        assert topDict.CharStrings.varStore is topDict.VarStore
+
+        def draw(font, location):
+            pen = RecordingPen()
+            font.getGlyphSet(location=location)["I"].draw(pen)
+            return pen.value
+
+        expected = draw(fontFromOTF, location)
+        assert expected != draw(fontFromOTF, {})
+        assert draw(fontFromTTX, location) == expected
+
     @pytest.mark.parametrize(
         "fontfile", ["I.otf", "../../cffLib/data/varc-short-cff2.otf"]
     )
