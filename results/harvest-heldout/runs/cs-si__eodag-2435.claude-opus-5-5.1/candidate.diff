+    @staticmethod
+    def _check_dates_validity(start: Any = None, end: Any = None) -> None:
+        """Check that the given search dates can be parsed and are consistent.
+
+        Invalid dates (e.g. ``"2023-11-31"``) are rejected before being sent to the
+        provider, which may otherwise answer with an unexplicit server error.
+
+        :param start: (optional) Start date of the search
+        :param end: (optional) End date of the search
+        :raises ValidationError: If a date cannot be parsed, or if start is after end
+        """
+        parsed: dict[str, dt.datetime] = {}
+        for name, value in (("start", start), ("end", end)):
+            if value is None or value == "":
+                continue
+            if isinstance(value, dt.datetime):
+                parsed[name] = ensure_utc(value)
+                continue
+            if isinstance(value, dt.date):
+                parsed[name] = ensure_utc(
+                    dt.datetime.combine(value, dt.datetime.min.time())
+                )
+                continue
+            if not isinstance(value, str):
+                raise ValidationError(
+                    f"Invalid {name} date: {value!r} (expected an ISO 8601 string)",
+                    {name},
+                )
+            try:
+                parsed[name] = parse_to_utc(value)
+            except (ValidationError, OverflowError) as e:
+                raise ValidationError(
+                    f"Invalid {name} date: {value!r}", {name}
+                ) from e
+        if "start" in parsed and "end" in parsed and parsed["start"] > parsed["end"]:
+            raise ValidationError(
+                f"Start date ({start}) must be before end date ({end})",
+                {"start", "end"},
+            )
+
