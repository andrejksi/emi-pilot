             self.assertFalse(arch_path.exists())
             self.assertTrue(os.path.isfile(Path(output_dir) / "FOO" / "FOO.bar"))
 
+    def _write_archive(self, arch_path: Path, contents: dict[str, bytes]) -> None:
+        if arch_path.suffix.lower() == ".zip":
+            with zipfile.ZipFile(arch_path, "w") as zfile:
+                for name, data in contents.items():
+                    zfile.writestr(name, data)
+        else:
+            with tarfile.open(arch_path, "w:gz") as tar:
+                for name, data in contents.items():
+                    member = tarfile.TarInfo(name)
+                    member.size = len(data)
+                    tar.addfile(member, io.BytesIO(data))
+
+    def test_plugins_download_base_finalize_archive_depth_keeps_all_files(self):
+        """Download._finalize must extract every file when archive root holds several entries."""
+        plugin = self.get_download_plugin(self.product)
+        contents = {"EOPMetadata.xml": b"<xml/>", "product.nat": b"data" * 10}
+        for extension in (".zip", ".tgz"):
+            with (
+                self.subTest(extension=extension),
+                TemporaryDirectory() as output_dir,
+                mock.patch.object(plugin.config, "archive_depth", 2, create=True),
+            ):
+                arch_path = Path(output_dir) / f"FOO{extension}"
+                self._write_archive(arch_path, contents)
+                product_path = plugin._finalize(
+                    str(arch_path),
+                    output_dir=output_dir,
+                    extract=True,
+                    delete_archive=False,
+                )
+                self.assertEqual(product_path, os.path.join(output_dir, "FOO"))
+                self.assertCountEqual(os.listdir(product_path), list(contents))
+                for name, data in contents.items():
+                    self.assertEqual((Path(product_path) / name).read_bytes(), data)
+
+    def test_plugins_download_base_finalize_archive_depth_single_dir(self):
+        """Download._finalize must go down a single top directory when archive_depth > 1."""
+        plugin = self.get_download_plugin(self.product)
+        contents = {"top/a.txt": b"a", "top/sub/b.txt": b"bb"}
+        with (
+            TemporaryDirectory() as output_dir,
+            mock.patch.object(plugin.config, "archive_depth", 2, create=True),
+        ):
+            arch_path = Path(output_dir) / "FOO.zip"
+            self._write_archive(arch_path, contents)
+            product_path = plugin._finalize(
+                str(arch_path), output_dir=output_dir, extract=True
+            )
+            self.assertCountEqual(os.listdir(product_path), ["a.txt", "sub"])
+            self.assertTrue(os.path.isfile(Path(product_path) / "sub" / "b.txt"))
+            # complete extraction is not redone
+            with self.assertLogs(level="INFO") as cm:
+                plugin._finalize(str(arch_path), output_dir=output_dir, extract=True)
+            self.assertIn("Extraction cancelled", str(cm.output))
+
+    def test_plugins_download_base_finalize_reextract_incomplete(self):
+        """Download._finalize must extract again a destination directory missing archive files."""
+        plugin = self.get_download_plugin(self.product)
+        contents = {"EOPMetadata.xml": b"<xml/>", "product.nat": b"data" * 10}
+        for archive_depth in (1, 2):
+            with (
+                self.subTest(archive_depth=archive_depth),
+                TemporaryDirectory() as output_dir,
+                mock.patch.object(
+                    plugin.config, "archive_depth", archive_depth, create=True
+                ),
+            ):
+                arch_path = Path(output_dir) / "FOO.zip"
+                self._write_archive(arch_path, contents)
+                # an incomplete previous extraction
+                incomplete_dir = Path(output_dir) / "FOO"
+                incomplete_dir.mkdir()
+                (incomplete_dir / "EOPMetadata.xml").write_bytes(b"<xml/>")
+
+                with self.assertLogs(level="WARNING") as cm:
+                    product_path = plugin._finalize(
+                        str(arch_path),
+                        output_dir=output_dir,
+                        extract=True,
+                        delete_archive=False,
+                    )
+                self.assertIn("is incomplete", str(cm.output))
+                self.assertCountEqual(os.listdir(product_path), list(contents))
+                self.assertEqual(
+                    (Path(product_path) / "product.nat").read_bytes(), b"data" * 10
+                )
+                self.assertTrue(arch_path.is_file())
+
 
