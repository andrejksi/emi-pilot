+def _getElidedFallbackNameID(stat):
+    # The ElidedFallbackNameID field only exists from STAT version 1.1 on. In a
+    # version 1.0 table it is absent, and any value left on the object is not
+    # part of the table, so ignore it and fall back to the subfamily name
+    # (nameID 2), the same default the STAT builder uses.
+    if getattr(stat, "Version", 0x00010001) < 0x00010001:
+        return 2
+    elidedNameID = getattr(stat, "ElidedFallbackNameID", None)
+    return 2 if elidedNameID is None else elidedNameID
+
