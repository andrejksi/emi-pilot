--- a/singer_sdk/singerlib/schema.py
+++ b/singer_sdk/singerlib/schema.py
@@ -2,6 +2,7 @@
 
 from __future__ import annotations
 
+import copy
 import typing as t
 from dataclasses import dataclass
 
@@ -261,8 +262,10 @@ def _resolve_schema_references(  # noqa: C901, PLR0912
     Args:
         schema: The schema dict to resolve references in
         resolver: The JSON Schema resolver to use
-        visited_refs: Set of already visited reference paths to prevent infinite
-            recursion
+        visited_refs: Set of reference paths currently being resolved, used to
+            prevent infinite recursion for circular references. A reference is
+            only considered "visited" while it is being resolved, so the same
+            reference can be resolved again elsewhere in the schema.
 
     Returns:
         The schema with all references resolved
@@ -273,14 +276,19 @@ def _resolve_schema_references(  # noqa: C901, PLR0912
     if _SchemaKey.ref in schema:
         reference_path = schema.pop(_SchemaKey.ref, None)
         if reference_path in visited_refs:
-            # We've already seen this reference, return the schema as-is
-            # to prevent infinite recursion
+            # We're already resolving this reference further up the stack, so
+            # return the schema as-is to prevent infinite recursion.
             return schema
 
-        visited_refs.add(reference_path)
         resolved = resolver.lookup(reference_path)
-        schema.update(resolved.contents)
-        return _resolve_schema_references(schema, resolver, visited_refs)
+        # Copy the resolved contents so that sibling keys in the referring
+        # schema don't mutate the referenced schema in the registry.
+        schema.update(copy.deepcopy(resolved.contents))
+        visited_refs.add(reference_path)
+        try:
+            return _resolve_schema_references(schema, resolver, visited_refs)
+        finally:
+            visited_refs.discard(reference_path)
 
     if _SchemaKey.properties in schema:
         for k, val in schema[_SchemaKey.properties].items():
