+def format_section_comment(comment_prefix: str, comment: str) -> str:
+    """Format a standalone section heading or footer using ``comment_prefix``."""
+    prefix = comment_prefix.lstrip()
+    if not prefix:
+        return comment
+    if prefix.endswith((" ", "\t")):
+        return f"{prefix}{comment}"
+    return f"{prefix} {comment}"
+
