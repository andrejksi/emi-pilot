+    @staticmethod
+    def _list_archive_files(fs_path: str) -> Optional[list[tuple[list[str], int]]]:
+        """List the regular files of an archive, with their path parts and size.
+
+        :param fs_path: The path to the archive
+        :returns: A list of (path parts, size) for every regular file of the archive, or
+                  ``None`` if the archive type is not handled or the archive could not be read
+        """
+        fs_path_lower = fs_path.lower()
+        members: list[tuple[str, int]] = []
+        try:
+            if fs_path_lower.endswith(".zip"):
+                with zipfile.ZipFile(fs_path, "r") as zfile:
+                    members = [
+                        (info.filename, info.file_size)
+                        for info in zfile.infolist()
+                        if not info.is_dir()
+                    ]
+            elif fs_path_lower.endswith((".tar", ".tar.gz", ".tgz")):
+                with tarfile.open(fs_path, "r") as tfile:
+                    members = [
+                        (info.name, info.size)
+                        for info in tfile.getmembers()
+                        if info.isfile()
+                    ]
+            else:
+                return None
+        except (OSError, zipfile.BadZipFile, tarfile.TarError) as exc:
+            logger.debug(f"Could not list files of archive {fs_path}: {exc}")
+            return None
+
+        files = []
+        for name, size in members:
+            parts = [
+                part
+                for part in name.replace("\\", "/").split("/")
+                if part not in ("", ".")
+            ]
+            if not parts or ".." in parts or os.path.isabs(name):
+                # not extracted where its name says, it cannot be looked for
+                continue
+            files.append((parts, size))
+        return files
+
+    def _missing_extracted_files(self, fs_path: str, product_path: str) -> list[str]:
+        """Find the files of an archive that are missing from its extraction directory.
+
+        The archive depth is applied to the archive member names the same way it is
+        applied to the extracted tree in :meth:`_resolve_archive_depth`.
+
+        :param fs_path: The path to the archive
+        :param product_path: The path to the directory where the archive was extracted
+        :returns: The relative paths of the archive files missing from ``product_path``
+                  (or having a different size)
+        """
+        files = self._list_archive_files(fs_path)
+        if not files:
+            return []
+        archive_depth = getattr(self.config, "archive_depth", 1)
+        count = 1
+        while count < archive_depth:
+            top_entries = {parts[0] for parts, _ in files}
+            # a single top entry is a directory only if files are below it
+            if len(top_entries) != 1 or any(len(parts) < 2 for parts, _ in files):
+                break
+            files = [(parts[1:], size) for parts, size in files]
+            count += 1
+
+        missing = []
+        for parts, size in files:
+            extracted_path = os.path.join(product_path, *parts)
+            if (
+                not os.path.isfile(extracted_path)
+                or os.path.getsize(extracted_path) != size
+            ):
+                missing.append("/".join(parts))
+        return missing
+
