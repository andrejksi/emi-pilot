@@ -310,6 +310,41 @@ def test_hostname_parsing():
     assert only_hostname_with_path.http_scheme == constants.HTTP
 
 
+def test_http_scheme_is_inferred_from_port():
+    https_connection = Connection("mytrinoserver.domain", port=constants.DEFAULT_TLS_PORT)
+    assert https_connection.http_scheme == constants.HTTPS
+
+    http_connection = Connection("mytrinoserver.domain", port=constants.DEFAULT_PORT)
+    assert http_connection.http_scheme == constants.HTTP
+
+    default_connection = Connection("mytrinoserver.domain")
+    assert default_connection.http_scheme == constants.HTTP
+
+
+def test_http_scheme_explicit_argument_overrides_port():
+    connection = Connection(
+        "mytrinoserver.domain",
+        port=constants.DEFAULT_TLS_PORT,
+        http_scheme=constants.HTTP,
+    )
+    assert connection.http_scheme == constants.HTTP
+
+    connection = Connection(
+        "mytrinoserver.domain",
+        port=constants.DEFAULT_PORT,
+        http_scheme=constants.HTTPS,
+    )
+    assert connection.http_scheme == constants.HTTPS
+
+
+def test_http_scheme_in_host_overrides_explicit_argument():
+    connection = Connection(
+        "https://mytrinoserver.domain",
+        http_scheme=constants.HTTP,
+    )
+    assert connection.http_scheme == constants.HTTPS
+
+
