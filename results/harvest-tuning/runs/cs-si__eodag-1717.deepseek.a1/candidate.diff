+    def test_plugins_download_base_prepare_download_record_file_with_extension(self):
+        """Download._prepare_download must detect already downloaded files keeping their extension"""
+
+        self.product.location = self.product.remote_location = "http://foo.bar"
+        self.product.product_type = "foo"
+
+        with TemporaryDirectory() as output_dir:
+            download_kwargs = dict(output_dir=output_dir, extract=False)
+            product_path = Path(output_dir) / self.product.properties["title"]
+            recordfile_dir = Path(output_dir) / ".downloaded"
+            recordfile_dir.mkdir()
+
+            recordfile_path = (
+                recordfile_dir / hashlib.md5("foo-dummy".encode("utf-8")).hexdigest()
+            )
+
+            plugin = self.get_download_plugin(self.product)
+
+            # record file and product file with an extension exist (e.g. extract=False)
+            product_path_with_ext = product_path.with_suffix(".zip")
+            product_path_with_ext.touch()
+            recordfile_path.touch()
+            with self.assertLogs(level="INFO") as cm:
+                fs_path, record_filename = plugin._prepare_download(
+                    self.product, **download_kwargs
+                )
+                self.assertEqual(fs_path, str(product_path_with_ext))
+                self.assertIsNone(record_filename)
+                self.assertTrue(os.path.isfile(recordfile_path))
+                self.assertIn("Product already downloaded", str(cm.output))
+
