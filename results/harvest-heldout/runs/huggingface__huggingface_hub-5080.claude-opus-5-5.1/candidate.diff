+def _bucket_file(path: str, xet_hash: str) -> BucketFile:
+    return BucketFile(
+        type="file", path=path, size=4, xetHash=xet_hash, mtime=None, uploadedAt="2026-01-01T00:00:00.000Z"
+    )
+
+
+@pytest.fixture
+def bucket_fs():
+    """`HfFileSystem` with a mocked Hub serving `username/my_bucket` (with `data/a.tmp`) and `username/other_bucket`."""
+    fs = HfFileSystem(skip_instance_cache=True)
+    files = {"username/my_bucket": [_bucket_file("data/a.tmp", "hash_a")], "username/other_bucket": []}
+
+    def _bucket_info(bucket_id: str, *_, **kwargs):
+        if bucket_id not in files:
+            raise BucketNotFoundError(bucket_id, response=Mock())
+
+    def _get_bucket_paths_info(bucket_id: str, paths, **kwargs):
+        return [f for f in files[bucket_id] if f.path in paths]
+
+    def _list_bucket_tree(bucket_id: str, prefix=None, recursive=False, **kwargs):
+        return [f for f in files[bucket_id] if not prefix or f.path == prefix or f.path.startswith(prefix + "/")]
+
+    with (
+        patch.object(fs._api, "bucket_info", _bucket_info),
+        patch.object(fs._api, "get_bucket_paths_info", _get_bucket_paths_info),
+        patch.object(fs._api, "list_bucket_tree", _list_bucket_tree),
+        patch.object(fs._api, "batch_bucket_files") as batch_bucket_files,
+    ):
+        fs._api.batch_bucket_files = batch_bucket_files
+        yield fs
+
+
+def test_cp_file_within_bucket_copies_by_xet_hash(bucket_fs: HfFileSystem):
+    bucket_fs.cp_file("hf://buckets/username/my_bucket/data/a.tmp", "hf://buckets/username/my_bucket/data/a.txt")
+    bucket_fs._api.batch_bucket_files.assert_called_once_with(
+        "username/my_bucket", copy=[("bucket", "username/my_bucket", "hash_a", "data/a.txt")]
+    )
+
+
+def test_cp_file_between_buckets_copies_by_xet_hash(bucket_fs: HfFileSystem):
+    bucket_fs.cp_file("buckets/username/my_bucket/data/a.tmp", "buckets/username/other_bucket/b.txt")
+    bucket_fs._api.batch_bucket_files.assert_called_once_with(
+        "username/other_bucket", copy=[("bucket", "username/my_bucket", "hash_a", "b.txt")]
+    )
+
+
+def test_cp_file_from_missing_bucket_file(bucket_fs: HfFileSystem):
+    with pytest.raises(FileNotFoundError):
+        bucket_fs.cp_file("buckets/username/my_bucket/data/missing.txt", "buckets/username/my_bucket/data/b.txt")
+    bucket_fs._api.batch_bucket_files.assert_not_called()
+
+
+def test_mv_within_bucket(bucket_fs: HfFileSystem):
+    # Write-then-rename pattern (e.g. `torch.distributed.checkpoint`, `datasets`): copy, then delete the source
+    bucket_fs.mv("hf://buckets/username/my_bucket/data/a.tmp", "hf://buckets/username/my_bucket/data/a")
+    assert bucket_fs._api.batch_bucket_files.call_args_list == [
+        call("username/my_bucket", copy=[("bucket", "username/my_bucket", "hash_a", "data/a")]),
+        call("username/my_bucket", delete=["data/a.tmp"]),
+    ]
