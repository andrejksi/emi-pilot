diff --git a/tests/units/test_core.py b/tests/units/test_core.py
index d0fdd4f..bed5203 100644
--- a/tests/units/test_core.py
+++ b/tests/units/test_core.py
@@ -3462,6 +3462,46 @@ class TestCoreSearch(TestCoreBase):
         _, prepared_search = self.dag._prepare_search(**base)
         self.assertListEqual([("start_datetime", "DESC")], prepared_search["sort_by"])
 
+    @mock.patch(
+        "eodag.api.core.EODataAccessGateway.fetch_collections_list", autospec=True
+    )
+    def test__prepare_search_invalid_dates(self, mock_fetch_collections_list):
+        """_prepare_search must reject invalid dates before any request is sent"""
+        # non-existing day
+        with self.assertRaises(ValidationError):
+            self.dag._prepare_search(start="2020-01-01", end="2023-11-31")
+        with self.assertRaises(ValidationError):
+            self.dag._prepare_search(start="2023-02-29T00:00:00Z")
+        # unparsable date
+        with self.assertRaises(ValidationError):
+            self.dag._prepare_search(end="not-a-date")
+        # start after end
+        with self.assertRaises(ValidationError):
+            self.dag._prepare_search(start="2021-01-02", end="2021-01-01")
+        with self.assertRaises(ValidationError):
+            self.dag._prepare_search(
+                datetime="2021-01-02T00:00:00Z/2021-01-01T00:00:00Z"
+            )
+        # valid dates with time offsets are accepted
+        _, prepared_search = self.dag._prepare_search(
+            start="2021-01-01T10:00:00+02:00", end="2021-01-01T09:00:00Z"
+        )
+        self.assertEqual(prepared_search["start_datetime"], "2021-01-01T10:00:00+02:00")
+        # same start and end are accepted
+        self.dag._prepare_search(start="2021-01-01", end="2021-01-01")
+        # invalid dates make search fail without sending any request
+        with mock.patch(
+            "eodag.plugins.search.qssearch.QueryStringSearch._request", autospec=True
+        ) as mock_request:
+            with self.assertRaises(ValidationError):
+                self.dag.search(
+                    collection="S2_MSI_L1C",
+                    provider="peps",
+                    start="2020-01-01",
+                    end="2023-11-31",
+                )
+            mock_request.assert_not_called()
+
     @mock.patch(
         "eodag.api.core.EODataAccessGateway.fetch_collections_list", autospec=True
     )
