+@pytest.mark.parametrize(
+    "messages, flatten_messages_as_text, expected",
+    [
+        # Consecutive string contents stay strings
+        (
+            [
+                {"role": "system", "content": "Start with 'FOO'"},
+                {"role": "system", "content": "End with 'BAR'"},
+                {"role": "user", "content": "Just say '.'"},
+            ],
+            False,
+            [
+                {"role": "system", "content": "Start with 'FOO'\nEnd with 'BAR'"},
+                {"role": "user", "content": "Just say '.'"},
+            ],
+        ),
+        (
+            [
+                {"role": "system", "content": "Start with 'FOO'"},
+                {"role": "system", "content": "End with 'BAR'"},
+                {"role": "user", "content": "Just say '.'"},
+            ],
+            True,
+            [
+                {"role": "system", "content": "Start with 'FOO'\nEnd with 'BAR'"},
+                {"role": "user", "content": "Just say '.'"},
+            ],
+        ),
+        # String followed by list content
+        (
+            [
+                {"role": "system", "content": "Start with 'FOO'"},
+                {"role": "system", "content": [{"type": "text", "text": "End with 'BAR'"}]},
+            ],
+            False,
+            [{"role": "system", "content": [{"type": "text", "text": "Start with 'FOO'\nEnd with 'BAR'"}]}],
+        ),
+        # List followed by string content
+        (
+            [
+                {"role": "system", "content": [{"type": "text", "text": "Start with 'FOO'"}]},
+                {"role": "system", "content": "End with 'BAR'"},
+            ],
+            False,
+            [{"role": "system", "content": [{"type": "text", "text": "Start with 'FOO'\nEnd with 'BAR'"}]}],
+        ),
+        (
+            [
+                {"role": "system", "content": [{"type": "text", "text": "Start with 'FOO'"}]},
+                {"role": "system", "content": "End with 'BAR'"},
+            ],
+            True,
+            [{"role": "system", "content": "Start with 'FOO'\nEnd with 'BAR'"}],
+        ),
+    ],
+)
+def test_get_clean_message_list_consecutive_messages_with_string_content(messages, flatten_messages_as_text, expected):
+    original_messages = deepcopy(messages)
+    result = get_clean_message_list(messages, flatten_messages_as_text=flatten_messages_as_text)
+    assert result == expected
+    assert messages == original_messages
+
